<style>
	:root {
		--header-height : {{ section.settings.height }}px;
	}
	
	@media screen and (min-width: 1200px) {
		header-drawer {
			display: none;
		}
	}
	.menu-drawer-container {
		display: flex;
	}

	summary.list-menu__item {
		padding-right: 2.7rem;
	}

	/* menu + currency group */
	.header-top__menu-locale-group {
		display: flex;
		align-items: center;
		gap: 1rem;
		position: relative;
	}
	.header-top__menu-locale-group .header__icon--menu {
		margin: 0;
	}

	/* ============================================================= */
	/* CURRENCY / COUNTRY SELECTOR — UNIVERSAL FIX (theme-agnostic)  */
	/* This wrapper is OUR anchor, regardless of what's inside it.   */
	/* ============================================================= */
	#trtf-locale-wrapper {
		position: relative;
		display: inline-flex;
		align-items: center;
	}

	/* Broad-net CSS in case the theme uses common Dawn-style class names */
	#trtf-locale-wrapper .disclosure__list-wrapper,
	#trtf-locale-wrapper .disclosure-list,
	#trtf-locale-wrapper [role="listbox"],
	#trtf-locale-wrapper .popover,
	#trtf-locale-wrapper details > div,
	#trtf-locale-wrapper details > ul {
		position: absolute !important;
		top: 100% !important;
		bottom: auto !important;
		left: 0 !important;
		right: auto !important;
		transform: none !important;
		margin-top: 8px !important;
	}

	/* Anything JS marks as enhanced gets the full clean treatment */
	#trtf-locale-wrapper .trtf-enhanced-panel {
		position: absolute !important;
		top: 100% !important;
		bottom: auto !important;
		left: 0 !important;
		margin-top: 8px !important;
		width: max-content;
		min-width: 180px;
		max-width: 82vw;
		max-height: 280px;
		overflow-y: auto;
		-webkit-overflow-scrolling: touch;
		background: #fff;
		border-radius: 14px;
		border: 1px solid rgba(0,0,0,0.08);
		box-shadow: 0 10px 30px rgba(0,0,0,0.18);
		z-index: 999;
		opacity: 0;
		transform: translateY(-6px);
		transition: opacity 0.16s ease, transform 0.16s ease;
		pointer-events: none;
		scrollbar-width: thin;
	}
	#trtf-locale-wrapper .trtf-enhanced-panel.trtf-open {
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
	}
	#trtf-locale-wrapper .trtf-enhanced-panel::-webkit-scrollbar {
		width: 4px;
	}
	#trtf-locale-wrapper .trtf-enhanced-panel::-webkit-scrollbar-thumb {
		background: rgba(0,0,0,0.2);
		border-radius: 4px;
	}
	#trtf-locale-wrapper .trtf-enhanced-panel a,
	#trtf-locale-wrapper .trtf-enhanced-panel button,
	#trtf-locale-wrapper .trtf-enhanced-panel li {
		padding: 10px 16px !important;
		font-size: 14px !important;
		white-space: nowrap;
	}
</style>

