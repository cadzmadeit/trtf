<script>
(function () {
	// ============================================================
	// UNIVERSAL LOCALIZATION DROPDOWN FIX — works regardless of
	// what markup/classes the theme's snippet actually renders.
	// ============================================================
	function init() {
		var wrapper = document.getElementById('trtf-locale-wrapper');
		if (!wrapper) return;

		// The clickable trigger: first summary/button/select inside the wrapper
		var trigger = wrapper.querySelector('summary, button, [role="button"]');
		var detailsEl = wrapper.querySelector('details');

		// Find the "panel" — whatever element is NOT the trigger itself.
		function findPanel() {
			if (detailsEl) {
				// everything inside <details> that isn't the <summary>
				var kids = Array.prototype.slice.call(detailsEl.children).filter(function (el) {
					return el.tagName.toLowerCase() !== 'summary';
				});
				if (kids.length) return kids[0];
			}
			// fallback: look for common list/panel wrappers
			return wrapper.querySelector(
				'.disclosure__list-wrapper, .disclosure-list, [role="listbox"], .popover, ul, .dropdown, .localization-form__list'
			);
		}

		function positionPanel(panel) {
			if (!panel) return;
			panel.classList.add('trtf-enhanced-panel');

			// Always calculate fresh so it never opens off-screen or upward
			var triggerRect = (trigger || wrapper).getBoundingClientRect();
			var spaceBelow = window.innerHeight - triggerRect.bottom;
			var maxH = Math.max(160, Math.min(280, spaceBelow - 24));

			panel.style.maxHeight = maxH + 'px';
			panel.style.top = '100%';
			panel.style.bottom = 'auto';
			panel.style.left = '0';
		}

		function openPanel() {
			var panel = findPanel();
			if (!panel) return;
			positionPanel(panel);
			requestAnimationFrame(function () {
				panel.classList.add('trtf-open');
			});
		}

		function closePanel() {
			var panel = findPanel();
			if (!panel) return;
			panel.classList.remove('trtf-open');
		}

		// Support <details>-based disclosures (native toggle event)
		if (detailsEl) {
			detailsEl.addEventListener('toggle', function () {
				if (detailsEl.open) {
					openPanel();
				} else {
					closePanel();
				}
			});
		}

		// Support button/aria-expanded based disclosures
		if (trigger && !detailsEl) {
			trigger.addEventListener('click', function () {
				setTimeout(function () {
					var expanded = trigger.getAttribute('aria-expanded') === 'true';
					if (expanded) {
						openPanel();
					} else {
						closePanel();
					}
				}, 0);
			});
		}

		// Reposition on resize/scroll while open, so it never gets clipped
		window.addEventListener('resize', function () {
			var panel = findPanel();
			if (panel && panel.classList.contains('trtf-open')) positionPanel(panel);
		});

		// Close when clicking outside
		document.addEventListener('click', function (e) {
			if (!wrapper.contains(e.target)) {
				closePanel();
				if (detailsEl) detailsEl.open = false;
			}
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', init);
	} else {
		init();
	}
})();
</script>

{% javascript %}
	class StickyHeader extends HTMLElement {
	constructor() {
	super();
	}

	connectedCallback() {
	this.header = document.querySelector('.shopify-section-header');
	this.headerIsAlwaysSticky = this.getAttribute('data-sticky-type') === 'always';
	this.headerBounds = {};
	this.currentScrollTop = 0;
	this.preventReveal = false;

	if (this.headerIsAlwaysSticky) {
	this.header.classList.add('shopify-section-header-sticky');
	this.header.classList.add('always-fixed');
	};

	this.onScrollHandler = this.onScroll.bind(this);
	this.hideHeaderOnScrollUp = () => this.preventReveal = true;
	this.addEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
	window.addEventListener('scroll', this.onScrollHandler, false);

	this.createObserver();
	}

	disconnectedCallback() {
	this.removeEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
	window.removeEventListener('scroll', this.onScrollHandler);
	}

	createObserver() {
	let observer = new IntersectionObserver((entries, observer) => {
	this.headerBounds = entries[0].intersectionRect;
	observer.disconnect();
	});

	observer.observe(this.header);
	}

	onScroll() {
	const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

	if (scrollTop > this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
	if (this.preventHide) return;
	requestAnimationFrame(this.hide.bind(this));
	} else if (scrollTop < this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
	if (!this.preventReveal) {
	requestAnimationFrame(this.reveal.bind(this));
	}else {
	window.clearTimeout(this.isScrolling);

	this.isScrolling = setTimeout(() => {
	this.preventReveal = false;
	}, 66);

	requestAnimationFrame(this.hide.bind(this));
	}
	} else if (scrollTop <= this.headerBounds.top) {
	requestAnimationFrame(this.reset.bind(this));
	}

	this.currentScrollTop = scrollTop;
	}

	hide() {
	if (this.headerIsAlwaysSticky) return;
	this.header.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky');
	this.closeMenuDisclosure();
	}

	reveal() {
	if (this.headerIsAlwaysSticky) return;
	this.header.classList.add('shopify-section-header-sticky', 'animate');
	this.header.classList.add('shopify-section-header-sticky', 'animate');
	this.header.classList.remove('shopify-section-header-hidden');
	}

	reset() {
	if (this.headerIsAlwaysSticky) return;
	this.header.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
	}

	closeMenuDisclosure() {
	this.disclosures = this.disclosures || this.header.querySelectorAll('details-disclosure');
	this.disclosures.forEach(disclosure => disclosure.close());
	}

	}

	customElements.define('sticky-header', StickyHeader);

{% endjavascript %}

