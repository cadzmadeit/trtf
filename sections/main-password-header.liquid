<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: #fff;
    font-family: 'Courier New', Courier, monospace;
  }

  /* ── COUNTDOWN BAR ── */
  .countdown-bar {
    text-align: center;
    padding: 12px 16px;
    border-bottom: 1px solid #e0e0e0;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  /* ── LOGO ── */
  .pw-logo {
    text-align: center;
    padding: 28px 20px 20px;
  }
  .pw-logo img { max-height: 65px; }
  .pw-logo h1 { font-size: 26px; letter-spacing: 4px; }

  /* ── HERO PRODUCT IMAGES ── */
  .hero-images {
    display: flex;
    gap: 14px;
    justify-content: center;
    padding: 0 20px 30px;
  }
  .hero-images img {
    width: 46%;
    max-width: 210px;
    object-fit: contain;
  }

  /* ── DROP HEADLINE ── */
  .drop-section {
    text-align: center;
    padding: 0 24px 28px;
  }
  .drop-headline {
    font-size: 24px;
    font-weight: 900;
    letter-spacing: 2px;
    line-height: 1.3;
    text-transform: uppercase;
    margin-bottom: 12px;
    color: #111;
  }
  .drop-subtext {
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #555;
    margin-bottom: 24px;
  }

  /* ── BUTTONS ── */
  .pw-btn {
    display: block;
    width: 100%;
    max-width: 420px;
    margin: 0 auto 14px;
    background: #111;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 11px;
    font-weight: bold;
    font-family: 'Courier New', Courier, monospace;
    padding: 18px 20px;
    border: none;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
  }
  .pw-btn:hover { background: #333; color: #fff; }

  /* ── DIVIDER ── */
  .section-divider {
    border: none;
    border-top: 1px solid #e0e0e0;
    margin: 36px 0;
  }

  /* ── HOW TO PURCHASE ── */
  .how-section {
    text-align: center;
    padding: 0 24px 10px;
  }
  .section-title {
    font-size: 22px;
    font-weight: 900;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 14px;
    color: #111;
  }
  .section-body {
    font-size: 13px;
    line-height: 1.7;
    color: #444;
    margin-bottom: 24px;
    letter-spacing: 1px;
  }

  /* ── LIFESTYLE PHOTO ── */
  .lifestyle-photo {
    position: relative;
    margin: 0 0 30px;
  }
  .lifestyle-photo img {
    width: 100%;
    display: block;
    object-fit: cover;
    max-height: 500px;
  }
  .lifestyle-caption {
    position: absolute;
    bottom: 16px;
    left: 16px;
    color: #fff;
    text-shadow: 0 1px 4px rgba(0,0,0,0.6);
  }
  .lifestyle-caption .person-name {
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 1px;
  }
  .lifestyle-caption .product-name {
    font-size: 11px;
    letter-spacing: 1px;
    opacity: 0.9;
  }

  /* ── PRODUCT SLIDER ── */
  .slider-section {
    padding: 0 0 30px;
    text-align: center;
  }
  .slider-wrapper {
    position: relative;
    display: grid;
    grid-template-columns: 44px 1fr 44px;
    align-items: center;
    width: 100%;
  }
  .slider-chevron {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 48px;
    color: #111;
    line-height: 1;
    user-select: none;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 0;
  }
  .slider-chevron:hover { color: #555; }
  .slider-track-wrap {
    overflow: hidden;
    width: 100%;
  }
  .slider-track {
    display: flex;
    transition: transform 0.4s ease;
    will-change: transform;
  }
  .slider-slide {
    min-width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .slide-img-wrap {
    width: 100%;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background: #f4f4f4;
  }
  .slide-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── FOOTER NOTICE ── */
  .footer-notice {
    text-align: center;
    padding: 20px 24px 40px;
    font-size: 13px;
    letter-spacing: 1px;
    color: #333;
    border-top: 1px solid #e0e0e0;
  }
  .footer-notice a {
    color: #111;
    text-decoration: underline;
    font-weight: bold;
  }
</style>

<div class="pw-page">

  <!-- TOP BAR -->
  <div class="countdown-bar">THE WAIT ENDS SOON</div>

  <!-- LOGO -->
  <div class="pw-logo">
    {% if section.settings.logo %}
      <img src="{{ section.settings.logo | img_url: 'medium' }}" alt="{{ shop.name }}">
    {% else %}
      <h1>{{ shop.name }}</h1>
    {% endif %}
  </div>

  <!-- HERO PRODUCT IMAGES -->
  <div class="hero-images">
    {% if section.settings.hero_img_1 %}
      <img src="{{ section.settings.hero_img_1 | img_url: 'medium' }}" alt="Product 1">
    {% endif %}
    {% if section.settings.hero_img_2 %}
      <img src="{{ section.settings.hero_img_2 | img_url: 'medium' }}" alt="Product 2">
    {% endif %}
  </div>

  <!-- DROP HEADLINE + FIRST CTA -->
  <div class="drop-section">
    <div class="drop-headline">{{ section.settings.headline }}</div>
    <div class="drop-subtext">{{ section.settings.subtext }}</div>
    <a href="{{ section.settings.cta_url }}" class="pw-btn">{{ section.settings.cta_text }}</a>
  </div>

  <hr class="section-divider">

  <!-- LIFESTYLE PHOTO -->
  {% if section.settings.lifestyle_img %}
  <div class="lifestyle-photo">
    <img src="{{ section.settings.lifestyle_img | img_url: 'grande' }}" alt="Lifestyle">
    <div class="lifestyle-caption">
      <div class="person-name">{{ section.settings.lifestyle_name }}</div>
      <div class="product-name">{{ section.settings.lifestyle_product }}</div>
    </div>
  </div>
  {% endif %}

  <!-- HOW TO PURCHASE -->
  <div class="how-section">
    <div class="section-title">How to Purchase</div>
    <div class="section-body">{{ section.settings.how_to_body }}</div>
    <a href="{{ section.settings.sms_url }}" class="pw-btn">{{ section.settings.sms_btn_text }}</a>
  </div>

  <hr class="section-divider">

  <!-- PRODUCT SLIDER -->
  <div class="slider-section">
    <div class="slider-wrapper">

      <button class="slider-chevron" onclick="sliderPrev()">&#8249;</button>

      <div class="slider-track-wrap">
        <div class="slider-track" id="sliderTrack">
          {% assign slide_ids = 'slide1_img,slide2_img,slide3_img,slide4_img,slide5_img' | split: ',' %}
          {% for sid in slide_ids %}
            {% if section.settings[sid] %}
            <div class="slider-slide">
              <div class="slide-img-wrap">
                <img src="{{ section.settings[sid] | img_url: '2048x2048' }}" alt="Slide">
              </div>
            </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <button class="slider-chevron" onclick="sliderNext()">&#8250;</button>

    </div>

    <br>
    <a href="{{ section.settings.alert_url }}" class="pw-btn" style="max-width:420px; margin:0 auto;">
      {{ section.settings.alert_btn_text }}
    </a>
  </div>

  <!-- FOOTER NOTICE -->
  <div class="footer-notice">
    {{ section.settings.footer_notice }}
  </div>

</div>

<script>
  // Slider
  var sliderCurrent = 0;
  var sliderTotal = document.querySelectorAll('#sliderTrack .slider-slide').length;

  function goToSlide(n) {
    sliderCurrent = ((n % sliderTotal) + sliderTotal) % sliderTotal;
    document.getElementById("sliderTrack").style.transform = "translateX(-" + (sliderCurrent * 100) + "%)";
  }
  function sliderNext() { goToSlide(sliderCurrent + 1); }
  function sliderPrev() { goToSlide(sliderCurrent - 1); }

  setInterval(sliderNext, 4000);
</script>

{% schema %}
{
  "name": "Password Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },

    { "type": "header", "content": "Hero Section" },
    { "type": "image_picker", "id": "hero_img_1", "label": "Hero Product Image 1" },
    { "type": "image_picker", "id": "hero_img_2", "label": "Hero Product Image 2" },
    { "type": "text", "id": "headline", "label": "Drop Headline", "default": "NEW DROP AVAILABLE SATURDAY 3/29 @12PM CST." },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "WILL SELL OUT FAST. BE THERE OR DON'T." },
    { "type": "text", "id": "cta_text", "label": "First Button Text", "default": "TAP HERE FOR EARLY ACCESS" },
    { "type": "url", "id": "cta_url", "label": "First Button URL" },

    { "type": "header", "content": "Lifestyle Section" },
    { "type": "image_picker", "id": "lifestyle_img", "label": "Lifestyle Photo" },
    { "type": "text", "id": "lifestyle_name", "label": "Person Name", "default": "Yonna Jay" },
    { "type": "text", "id": "lifestyle_product", "label": "Product Name Caption", "default": "\"Snow Leopard\" Zip Up - Reversible" },

    { "type": "header", "content": "How To Purchase" },
    { "type": "textarea", "id": "how_to_body", "label": "Body Text", "default": "Enter SMS list for 1 hour early access + discounts when we drop." },
    { "type": "text", "id": "sms_btn_text", "label": "SMS Button Text", "default": "ENTER SMS LIST" },
    { "type": "url", "id": "sms_url", "label": "SMS Button URL" },

    { "type": "header", "content": "Product Slider (up to 5 images)" },
    { "type": "image_picker", "id": "slide1_img", "label": "Slide 1" },
    { "type": "image_picker", "id": "slide2_img", "label": "Slide 2" },
    { "type": "image_picker", "id": "slide3_img", "label": "Slide 3" },
    { "type": "image_picker", "id": "slide4_img", "label": "Slide 4" },
    { "type": "image_picker", "id": "slide5_img", "label": "Slide 5" },
    { "type": "text", "id": "alert_btn_text", "label": "Alert Button Text", "default": "ALERT ME WHEN THIS DROPS" },
    { "type": "url", "id": "alert_url", "label": "Alert Button URL" },

    { "type": "header", "content": "Footer" },
    { "type": "text", "id": "footer_notice", "label": "Footer Notice", "default": "Can't join SMS list? Get notified via email below." }
  ]
}
{% endschema %}