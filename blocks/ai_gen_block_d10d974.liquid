{% doc %}
  @prompt
    Create a horizontal image carousel that displays images in a clean grid-like format similar to the reference images. The carousel should automatically slide horizontally in a continuous loop without manual navigation controls. Images should be displayed in a clean, modern layout with proper spacing. On hover (desktop) or tap (mobile), show text overlays with small white text on semi-transparent black backgrounds. Images should be unclickable, autoplay smoothly with seamless looping, and include lazy loading. Focus on a clean, minimal aesthetic with smooth animations and responsive design for all screen sizes. the size of the images should be 804x1228. MAKE SURE the carousel is optimized for BOTH mobile and desktop view, meaning on desktop the images should not be too zoomed in and big, and on mobile I SHOULD NOT BE ABLE TO SCROLL HORIZONTALLY / zoom out what so ever, maintain the layout of mobile view. I want 20 image blocks and a customizable animation speed starting with a default of 25, keep everything the same but make it so when i hover the carousel continues auto sliding

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
.ai-carousel-container-{{ ai_gen_id }} {
  position: relative;
  width: 100%;
  overflow: hidden;
  margin: 0 auto;
}

.ai-carousel-track-{{ ai_gen_id }} {
  display: flex;
  width: fit-content;
  animation: ai-carousel-scroll-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
}

@keyframes ai-carousel-scroll-{{ ai_gen_id }} {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(calc(-100% / 2));
  }
}

.ai-carousel-item-{{ ai_gen_id }} {
  position: relative;
  width: {{ block.settings.image_width }}px;
  height: {{ block.settings.image_height }}px;
  margin: {{ block.settings.image_spacing }}px;
  overflow: hidden;
  border-radius: {{ block.settings.image_border_radius }}px;
}

.ai-carousel-image-{{ ai_gen_id }} {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.ai-carousel-placeholder-{{ ai_gen_id }} {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f4f4f4;
  border-radius: {{ block.settings.image_border_radius }}px;
}

.ai-carousel-overlay-{{ ai_gen_id }} {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  background: rgba(0, 0, 0, 0.7);
  color: white;
  padding: 10px;
  opacity: 0;
  transition: opacity 0.3s ease;
  font-size: {{ block.settings.overlay_text_size }}px;
}

.ai-carousel-item-{{ ai_gen_id }}:hover .ai-carousel-overlay-{{ ai_gen_id }} {
  opacity: 1;
}

@media screen and (max-width: 749px) {
  .ai-carousel-container-{{ ai_gen_id }} {
    width: 100vw;
    margin-left: -50vw;
    left: 50%;
    position: relative;
  }
  
  .ai-carousel-item-{{ ai_gen_id }} {
    width: calc({{ block.settings.image_width }}px * 0.5);
    height: calc({{ block.settings.image_height }}px * 0.5);
  }
  
  .ai-carousel-overlay-{{ ai_gen_id }} {
    font-size: calc({{ block.settings.overlay_text_size }}px * 0.8);
    padding: 8px;
  }
}
{% endstyle %}

<div class="ai-carousel-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-carousel-track-{{ ai_gen_id }}">
    {% for i in (1..block.settings.number_of_images) %}
      {% assign image_key = 'image_' | append: i %}
      {% assign text_key = 'text_' | append: i %}
      <div class="ai-carousel-item-{{ ai_gen_id }}">
        {% if block.settings[image_key] %}
          <img 
            src="{{ block.settings[image_key] | image_url: width: block.settings.image_width }}" 
            alt="{{ block.settings[image_key].alt | escape }}"
            loading="lazy"
            class="ai-carousel-image-{{ ai_gen_id }}"
            width="{{ block.settings.image_width }}"
            height="{{ block.settings.image_height }}"
          >
        {% else %}
          <div class="ai-carousel-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
        {% if block.settings[text_key] != blank %}
          <div class="ai-carousel-overlay-{{ ai_gen_id }}">
            {{ block.settings[text_key] }}
          </div>
        {% endif %}
      </div>
    {% endfor %}
    
    {% comment %} Duplicate items for seamless looping {% endcomment %}
    {% for i in (1..block.settings.number_of_images) %}
      {% assign image_key = 'image_' | append: i %}
      {% assign text_key = 'text_' | append: i %}
      <div class="ai-carousel-item-{{ ai_gen_id }}">
        {% if block.settings[image_key] %}
          <img 
            src="{{ block.settings[image_key] | image_url: width: block.settings.image_width }}" 
            alt="{{ block.settings[image_key].alt | escape }}"
            loading="lazy"
            class="ai-carousel-image-{{ ai_gen_id }}"
            width="{{ block.settings.image_width }}"
            height="{{ block.settings.image_height }}"
          >
        {% else %}
          <div class="ai-carousel-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
        {% if block.settings[text_key] != blank %}
          <div class="ai-carousel-overlay-{{ ai_gen_id }}">
            {{ block.settings[text_key] }}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

