{% schema %}
{
  "name": "Announcement bar",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#141414"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "item_spacing",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Space between items",
      "default": 40
    },
    {
      "type": "range",
      "id": "icon_text_spacing",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Icon to text spacing",
      "default": 8
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 14
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 20
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "fit",
          "label": "Fit to screen"
        },
        {
          "value": "scroll",
          "label": "Horizontal scroll"
        },
        {
          "value": "stack",
          "label": "Stack vertically"
        }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "mobile_padding_vertical",
      "min": 6,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Mobile vertical padding",
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_padding_horizontal",
      "min": 10,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Mobile horizontal padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_item_spacing",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Mobile space between items",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_icon_text_spacing",
      "min": 4,
      "max": 16,
      "step": 2,
      "unit": "px",
      "label": "Mobile icon to text spacing",
      "default": 6
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Mobile font size",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_icon_size",
      "min": 14,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Mobile icon size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Item 1"
    },
    {
      "type": "checkbox",
      "id": "item_1_enabled",
      "label": "Enable item 1",
      "default": true
    },
    {
      "type": "select",
      "id": "item_1_icon",
      "label": "Icon",
      "options": [
        {
          "value": "shipping",
          "label": "Shipping box"
        },
        {
          "value": "truck",
          "label": "Delivery truck"
        },
        {
          "value": "gift",
          "label": "Gift"
        },
        {
          "value": "shield",
          "label": "Shield"
        },
