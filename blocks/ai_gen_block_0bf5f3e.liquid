{% doc %}
  @prompt
    Create a mobile-responsive announcement bar section that displays promotional messages horizontally on mobile devices. The section should have a dark background with white text and icons, showing three items: "Free Shipping", "Free Mystery item", and "Secure Payments" with appropriate icons. On mobile, the items should be displayed in a single row with proper spacing and sizing for mobile screens. Include customization options for background color, text color, icon selection, and message text for each promotional item.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-bar-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    width: 100%;
    overflow: hidden;
  }

  .ai-announcement-bar-container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ block.settings.item_spacing }}px;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-announcement-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.icon_text_spacing }}px;
    flex-shrink: 0;
    white-space: nowrap;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
  }

  .ai-announcement-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    color: {{ block.settings.icon_color }};
  }

  .ai-announcement-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding_vertical }}px {{ block.settings.mobile_padding_horizontal }}px;
    }

    .ai-announcement-bar-container-{{ ai_gen_id }} {
      gap: {{ block.settings.mobile_item_spacing }}px;
      {% if block.settings.mobile_layout == 'scroll' %}
        overflow-x: auto;
        justify-content: flex-start;
        scrollbar-width: none;
        -ms-overflow-style: none;
      {% endif %}
    }

    {% if block.settings.mobile_layout == 'scroll' %}
      .ai-announcement-bar-container-{{ ai_gen_id }}::-webkit-scrollbar {
        display: none;
      }
    {% endif %}

    .ai-announcement-item-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_font_size }}px;
      gap: {{ block.settings.mobile_icon_text_spacing }}px;
    }

    .ai-announcement-icon-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_icon_size }}px;
      height: {{ block.settings.mobile_icon_size }}px;
    }
  }

  @media screen and (max-width: 480px) {
    {% if block.settings.mobile_layout == 'stack' %}
      .ai-announcement-bar-container-{{ ai_gen_id }} {
        flex-direction: column;
        gap: {{ block.settings.mobile_item_spacing | divided_by: 2 }}px;
      }
    {% endif %}
  }
{% endstyle %}

<div class="ai-announcement-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-announcement-bar-container-{{ ai_gen_id }}">
    {% if block.settings.item_1_enabled %}
      <div class="ai-announcement-item-{{ ai_gen_id }}">
        <div class="ai-announcement-icon-{{ ai_gen_id }}">
          {% case block.settings.item_1_icon %}
            {% when 'shipping' %}
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
