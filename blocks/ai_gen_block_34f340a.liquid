{% doc %}
  @prompt
    Create a fully customizable product review section that displays a mix of text-only reviews and reviews with customer photos in a scattered, dynamic layout. Include verified buyer badges for some reviews, star ratings, customer names, and review text. The section should have customization options for colors, spacing, layout style, and the ability to toggle verified badges. Make it visually engaging with a modern design that alternates between different review card styles., make it clean, concise and compact layout. Make sure it doesnt mess with the optimized layout for desktop and mobile view. I like the layout/format you did for the reviews with the badge. keep that the same, you did not make the layout optimzied so that I can add images to certain reviews. on mobile view it should be two reviews vertical next to each other, but at different heights to give a clean concise look. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-reviews-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-reviews-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-reviews-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 8px;
  }

  .ai-reviews-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-reviews-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.card_spacing }}px;
    grid-auto-flow: dense;
  }

  .ai-review-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: {{ block.settings.card_shadow_x }}px {{ block.settings.card_shadow_y }}px {{ block.settings.card_shadow_blur }}px {{ block.settings.card_shadow_color }};
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .ai-review-card-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    box-shadow: {{ block.settings.card_shadow_x | times: 1.5 }}px {{ block.settings.card_shadow_y | times: 1.5 }}px {{ block.settings.card_shadow_blur | times: 1.5 }}px {{ block.settings.card_shadow_color }};
  }

  .ai-review-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .ai-review-customer-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ai-review-avatar-{{ ai_gen_id }} {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: {{ block.settings.avatar_background }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    color: {{ block.settings.avatar_text_color }};
    font-size: 14px;
    flex-shrink: 0;
  }

  .ai-review-customer-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ai-review-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.name_size }}px;
    font-weight: 600;
    color: {{ block.settings.name_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-review-date-{{ ai_gen_id }} {
    font-size: {{ block.settings.date_size }}px;
    color: {{ block.settings.date_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-review-verified-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background-color: {{ block.settings.verified_bg_color }};
    color: {{ block.settings.verified_text_color }};
    padding: 4px 8px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .ai-review-verified-icon-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
  }

  .ai-review-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 2px;
    margin-bottom: 10px;
  }

  .ai-review-star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    color: {{ block.settings.star_color }};
  }

  .ai-review-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_text_size }}px;
    line-height: 1.5;
    color: {{ block.settings.review_text_color }};
    margin: 0;
  }

  .ai-review-images-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
    margin-top: 12px;
  }

  .ai-review-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-review-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .ai-review-image-{{ ai_gen_id }}:hover {
    transform: scale(1.05);
  }

  @media screen and (max-width: 989px) {
    .ai-reviews-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-reviews-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.7 }}px 16px;
    }

    .ai-reviews-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.card_spacing | times: 0.75 }}px;
    }

    .ai-reviews-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.75 }}px;
    }

    .ai-reviews-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-review-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.75 }}px;
    }

    .ai-review-card-{{ ai_gen_id }}:nth-child(odd) {
      margin-top: 0;
    }

    .ai-review-card-{{ ai_gen_id }}:nth-child(even) {
      margin-top: 30px;
    }

    .ai-review-images-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<product-reviews-{{ ai_gen_id }} class="ai-reviews-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-reviews-container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank or block.settings.section_subtitle != blank %}
      <div class="ai-reviews-header-{{ ai_gen_id }}">
        {% if block.settings.section_title != blank %}
          <h2 class="ai-reviews-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
        {% endif %}
        {% if block.settings.section_subtitle != blank %}
          <p class="ai-reviews-subtitle-{{ ai_gen_id }}">{{ block.settings.section_subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-reviews-grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign review_enabled_key = 'review_' | append: i | append: '_enabled'
          assign review_name_key = 'review_' | append: i | append: '_name'
          assign review_date_key = 'review_' | append: i | append: '_date'
          assign review_rating_key = 'review_' | append: i | append: '_rating'
          assign review_text_key = 'review_' | append: i | append: '_text'
          assign review_verified_key = 'review_' | append: i | append: '_verified'
          assign review_image1_key = 'review_' | append: i | append: '_image_1'
          assign review_image2_key = 'review_' | append: i | append: '_image_2'

          assign review_enabled = block.settings[review_enabled_key]
          assign review_name = block.settings[review_name_key]
          assign review_date = block.settings[review_date_key]
          assign review_rating = block.settings[review_rating_key]
          assign review_text = block.settings[review_text_key]
          assign review_verified = block.settings[review_verified_key]
          assign review_image1 = block.settings[review_image1_key]
          assign review_image2 = block.settings[review_image2_key]

          assign initials = review_name | slice: 0, 1 | upcase
        %}

        {% if review_enabled %}
          <div class="ai-review-card-{{ ai_gen_id }}" data-review-id="{{ i }}">
            <div class="ai-review-header-{{ ai_gen_id }}">
              <div class="ai-review-customer-{{ ai_gen_id }}">
                <div class="ai-review-avatar-{{ ai_gen_id }}">{{ initials }}</div>
                <div class="ai-review-customer-info-{{ ai_gen_id }}">
                  <p class="ai-review-name-{{ ai_gen_id }}">{{ review_name }}</p>
                  {% if review_date != blank %}
                    <p class="ai-review-date-{{ ai_gen_id }}">{{ review_date }}</p>
                  {% endif %}
                </div>
              </div>
              {% if review_verified and block.settings.show_verified_badge %}
                <span class="ai-review-verified-{{ ai_gen_id }}">
                  <svg class="ai-review-verified-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M9 12L11 14L15 10M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  Verified
                </span>
              {% endif %}
            </div>

            <div class="ai-review-stars-{{ ai_gen_id }}">
              {% for star in (1..5) %}
                <svg class="ai-review-star-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="{% if star <= review_rating %}currentColor{% else %}none{% endif %}" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% endfor %}
            </div>

            {% if review_text != blank %}
              <p class="ai-review-text-{{ ai_gen_id }}">{{ review_text }}</p>
            {% endif %}

            {% if review_image1 or review_image2 %}
              <div class="ai-review-images-{{ ai_gen_id }}">
                {% if review_image1 %}
                  <div class="ai-review-image-wrapper-{{ ai_gen_id }}">
                    <img 
                      src="{{ review_image1 | image_url: width: 300 }}" 
                      alt="Review photo by {{ review_name }}"
                      class="ai-review-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="300"
                      height="300"
                    >
                  </div>
                {% endif %}
                {% if review_image2 %}
                  <div class="ai-review-image-wrapper-{{ ai_gen_id }}">
                    <img 
                      src="{{ review_image2 | image_url: width: 300 }}" 
                      alt="Review photo by {{ review_name }}"
                      class="ai-review-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="300"
                      height="300"
                    >
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</product-reviews-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductReviews{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const images = this.querySelectorAll('.ai-review-image-{{ ai_gen_id }}');
        images.forEach(img => {
          img.addEventListener('click', function() {
            window.open(this.src, '_blank');
          });
        });
      }
    }

    customElements.define('product-reviews-{{ ai_gen_id }}', ProductReviews{{ ai_gen_id }});
  })();
</script>

