        {% if review_1_text != blank %}
          <div class="ai-review-carousel-card-{{ ai_gen_id }}">
            <div class="ai-review-carousel-card-stars-{{ ai_gen_id }}">
              {% for i in (1..review_1_rating) %}
                <svg class="ai-review-carousel-card-star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {% endfor %}
            </div>
            {% if review_1_location != blank %}
              <div class="ai-review-carousel-card-location-{{ ai_gen_id }}">{{ review_1_location }}</div>
            {% endif %}
            <div class="ai-review-carousel-card-text-{{ ai_gen_id }}">{{ review_1_text }}</div>
            <div class="ai-review-carousel-card-footer-{{ ai_gen_id }}">
              <span class="ai-review-carousel-card-name-{{ ai_gen_id }}">{{ review_1_name }}</span>
              <span class="ai-review-carousel-card-date-{{ ai_gen_id }}">{{ review_1_date }}</span>
            </div>
          </div>
        {% endif %}

        {% if review_2_text != blank %}
          <div class="ai-review-carousel-card-{{ ai_gen_id }}">
            <div class="ai-review-carousel-card-stars-{{ ai_gen_id }}">
              {% for i in (1..review_2_rating) %}
                <svg class="ai-review-carousel-card-star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {% endfor %}
            </div>
            {% if review_2_location != blank %}
              <div class="ai-review-carousel-card-location-{{ ai_gen_id }}">{{ review_2_location }}</div>
            {% endif %}
            <div class="ai-review-carousel-card-text-{{ ai_gen_id }}">{{ review_2_text }}</div>
            <div class="ai-review-carousel-card-footer-{{ ai_gen_id }}">
              <span class="ai-review-carousel-card-name-{{ ai_gen_id }}">{{ review_2_name }}</span>
              <span class="ai-review-carousel-card-date-{{ ai_gen_id }}">{{ review_2_date }}</span>
            </div>
          </div>
        {% endif %}

        {% if review_3_text != blank %}
          <div class="ai-review-carousel-card-{{ ai_gen_id }}">
            <div class="ai-review-carousel-card-stars-{{ ai_gen_id }}">
              {% for i in (1..review_3_rating) %}
                <svg class="ai-review-carousel-card-star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {% endfor %}
            </div>
            {% if review_3_location != blank %}
              <div class="ai-review-carousel-card-location-{{ ai_gen_id }}">{{ review_3_location }}</div>
            {% endif %}
            <div class="ai-review-carousel-card-text-{{ ai_gen_id }}">{{ review_3_text }}</div>
            <div class="ai-review-carousel-card-footer-{{ ai_gen_id }}">
              <span class="ai-review-carousel-card-name-{{ ai_gen_id }}">{{ review_3_name }}</span>
              <span class="ai-review-carousel-card-date-{{ ai_gen_id }}">{{ review_3_date }}</span>
            </div>
          </div>
        {% endif %}

        {% if review_4_text != blank %}
          <div class="ai-review-carousel-card-{{ ai_gen_id }}">
            <div class="ai-review-carousel-card-stars-{{ ai_gen_id }}">
              {% for i in (1..review_4_rating) %}
                <svg class="ai-review-carousel-card-star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {% endfor %}
            </div>
            {% if review_4_location != blank %}
              <div class="ai-review-carousel-card-location-{{ ai_gen_id }}">{{ review_4_location }}</div>
            {% endif %}
            <div class="ai-review-carousel-card-text-{{ ai_gen_id }}">{{ review_4_text }}</div>
            <div class="ai-review-carousel-card-footer-{{ ai_gen_id }}">
              <span class="ai-review-carousel-card-name-{{ ai_gen_id }}">{{ review_4_name }}</span>
              <span class="ai-review-carousel-card-date-{{ ai_gen_id }}">{{ review_4_date }}</span>
            </div>
          </div>
        {% endif %}

        {% if review_5_text != blank %}
          <div class="ai-review-carousel-card-{{ ai_gen_id }}">
            <div class="ai-review-carousel-card-stars-{{ ai_gen_id }}">
              {% for i in (1..review_5_rating) %}
                <svg class="ai-review-carousel-card-star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {% endfor %}
