</review-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ReviewCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('.ai-review-carousel-track-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-review-carousel-nav-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-review-carousel-nav-next-{{ ai_gen_id }}');
        this.cards = Array.from(this.querySelectorAll('.ai-review-carousel-card-{{ ai_gen_id }}'));
        this.autoScroll = this.dataset.autoScroll === 'true';
        this.autoScrollSpeed = parseInt(this.dataset.autoScrollSpeed) || 5000;
        this.autoScrollInterval = null;
        this.originalCards = [];
      }

      connectedCallback() {
        if (this.cards.length === 0) return;
        
        this.originalCards = this.cards.map(card => card.cloneNode(true));
        this.createInfiniteLoop();
        this.setupEventListeners();
        
        if (this.autoScroll) {
          this.startAutoScroll();
        }
      }

      disconnectedCallback() {
        this.stopAutoScroll();
      }

      createInfiniteLoop() {
        const clonesBefore = this.originalCards.map(card => {
          const clone = card.cloneNode(true);
          clone.setAttribute('aria-hidden', 'true');
          return clone;
        });
        
        const clonesAfter = this.originalCards.map(card => {
          const clone = card.cloneNode(true);
          clone.setAttribute('aria-hidden', 'true');
          return clone;
        });

        clonesBefore.forEach(clone => this.track.insertBefore(clone, this.track.firstChild));
        clonesAfter.forEach(clone => this.track.appendChild(clone));

        this.allCards = Array.from(this.track.querySelectorAll('.ai-review-carousel-card-{{ ai_gen_id }}'));
        
        const cardWidth = this.cards[0].offsetWidth;
        const gap = window.innerWidth <= 749 ? 16 : 20;
        const initialScroll = this.originalCards.length * (cardWidth + gap);
        this.track.scrollLeft = initialScroll;
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.scrollPrev());
        this.nextButton.addEventListener('click', () => this.scrollNext());
        
        this.track.addEventListener('scroll', () => {
          this.handleInfiniteScroll();
          if (this.autoScroll) {
            this.resetAutoScroll();
          }
        });

        let isDown = false;
        let startX;
        let scrollLeft;

        this.track.addEventListener('mousedown', (e) => {
          isDown = true;
          startX = e.pageX - this.track.offsetLeft;
          scrollLeft = this.track.scrollLeft;
          this.track.style.cursor = 'grabbing';
        });

        this.track.addEventListener('mouseleave', () => {
          isDown = false;
          this.track.style.cursor = 'grab';
        });

        this.track.addEventListener('mouseup', () => {
          isDown = false;
          this.track.style.cursor = 'grab';
        });

        this.track.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - this.track.offsetLeft;
          const walk = (x - startX) * 2;
          this.track.scrollLeft = scrollLeft - walk;
        });

        this.track.addEventListener('touchstart', () => {
          if (this.autoScroll) {
            this.stopAutoScroll();
          }
        });

        this.track.addEventListener('touchend', () => {
          if (this.autoScroll) {
            this.resetAutoScroll();
          }
        });
      }

      handleInfiniteScroll() {
        const cardWidth = this.cards[0].offsetWidth;
        const gap = window.innerWidth <= 749 ? 16 : 20;
        const sectionWidth = this.originalCards.length * (cardWidth + gap);
        
        if (this.track.scrollLeft <= 0) {
          this.track.scrollLeft = sectionWidth;
        } else if (this.track.scrollLeft >= sectionWidth * 2) {
          this.track.scrollLeft = sectionWidth;
        }
      }

      scrollPrev() {
        const cardWidth = this.cards[0].offsetWidth;
        const gap = window.innerWidth <= 749 ? 16 : 20;
        this.track.scrollBy({
          left: -(cardWidth + gap),
          behavior: 'smooth'
        });
      }

      scrollNext() {
        const cardWidth = this.cards[0].offsetWidth;
        const gap = window.innerWidth <= 749 ? 16 : 20;
        this.track.scrollBy({
          left: cardWidth + gap,
          behavior: 'smooth'
        });
      }

      startAutoScroll() {
        this.autoScrollInterval = setInterval(() => {
          this.scrollNext();
        }, this.autoScrollSpeed);
      }

      stopAutoScroll() {
        if (this.autoScrollInterval) {
          clearInterval(this.autoScrollInterval);
          this.autoScrollInterval = null;
        }
      }

      resetAutoScroll() {
        this.stopAutoScroll();
        if (this.autoScroll) {
          this.startAutoScroll();
        }
      }
    }

    customElements.define('review-carousel-{{ ai_gen_id }}', ReviewCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Customer review carousel",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Title",
      "default": "Customer Reviews"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#141414"
    },
    {
