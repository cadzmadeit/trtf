            {% for i in (1..5) %}
              <svg class="ai-review-carousel-star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% endfor %}
          </div>
          <span>{{ block.settings.average_rating }} ({{ block.settings.total_reviews }} reviews)</span>
        </div>
      {% endif %}
    </div>

    <div class="ai-review-carousel-wrapper-{{ ai_gen_id }}">
      <button
        class="ai-review-carousel-nav-{{ ai_gen_id }} ai-review-carousel-nav-prev-{{ ai_gen_id }}"
        aria-label="Previous reviews"
      >
        <svg class="ai-review-carousel-nav-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="ai-review-carousel-track-{{ ai_gen_id }}">
        {% liquid
          assign review_1_rating = block.settings.review_1_rating
          assign review_1_location = block.settings.review_1_location
          assign review_1_text = block.settings.review_1_text
          assign review_1_name = block.settings.review_1_name
          assign review_1_date = block.settings.review_1_date

          assign review_2_rating = block.settings.review_2_rating
          assign review_2_location = block.settings.review_2_location
          assign review_2_text = block.settings.review_2_text
          assign review_2_name = block.settings.review_2_name
          assign review_2_date = block.settings.review_2_date

          assign review_3_rating = block.settings.review_3_rating
          assign review_3_location = block.settings.review_3_location
          assign review_3_text = block.settings.review_3_text
          assign review_3_name = block.settings.review_3_name
          assign review_3_date = block.settings.review_3_date

          assign review_4_rating = block.settings.review_4_rating
          assign review_4_location = block.settings.review_4_location
          assign review_4_text = block.settings.review_4_text
          assign review_4_name = block.settings.review_4_name
          assign review_4_date = block.settings.review_4_date

          assign review_5_rating = block.settings.review_5_rating
          assign review_5_location = block.settings.review_5_location
          assign review_5_text = block.settings.review_5_text
          assign review_5_name = block.settings.review_5_name
          assign review_5_date = block.settings.review_5_date
