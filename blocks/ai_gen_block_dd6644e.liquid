{% doc %}
  @prompt
    Create a responsive featured collection carousel that displays multiple collections in a sliding carousel format. The carousel should show collection images, titles, and be fully responsive with touch/swipe support on mobile. Include navigation arrows for desktop and smooth scrolling. Allow customization of the number of collections to display, spacing between items, and collection selection through the theme editor.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-carousel-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-collection-carousel__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
    padding: 0 20px;
  }

  .ai-collection-carousel__heading-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-collection-carousel__wrapper-{{ ai_gen_id }} {
    position: relative;
    padding: 0 20px;
  }

  .ai-collection-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.item_spacing }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-snap-type: x mandatory;
    padding-bottom: 10px;
  }

  .ai-collection-carousel__track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-carousel__item-{{ ai_gen_id }} {
    flex: 0 0 auto;
    width: calc((100% - ({{ block.settings.items_per_row_mobile | minus: 1 }} * {{ block.settings.item_spacing }}px)) / {{ block.settings.items_per_row_mobile }});
    scroll-snap-align: start;
  }

  .ai-collection-carousel__card-{{ ai_gen_id }} {
    position: relative;
    display: block;
    text-decoration: none;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .ai-collection-carousel__card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-collection-carousel__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background-color: #f6f6f6;
  }

  .ai-collection-carousel__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-carousel__image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f6f6f6;
  }

  .ai-collection-carousel__image-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-collection-carousel__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,{{ block.settings.overlay_opacity }}) 100%);
    display: flex;
    align-items: flex-end;
    padding: 20px;
  }

  .ai-collection-carousel__title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    font-weight: 600;
  }

  .ai-collection-carousel__nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    background-color: {{ block.settings.nav_button_color }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background-color 0.3s ease, opacity 0.3s ease;
    opacity: 0.9;
  }

  .ai-collection-carousel__nav-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_color }};
    opacity: 1;
  }

  .ai-collection-carousel__nav-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-collection-carousel__nav--prev-{{ ai_gen_id }} {
    left: 0;
  }

  .ai-collection-carousel__nav--next-{{ ai_gen_id }} {
    right: 0;
  }

  .ai-collection-carousel__nav-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    stroke: {{ block.settings.nav_icon_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-collection-carousel__item-{{ ai_gen_id }} {
      width: calc((100% - ({{ block.settings.items_per_row_tablet | minus: 1 }} * {{ block.settings.item_spacing }}px)) / {{ block.settings.items_per_row_tablet }});
    }

    .ai-collection-carousel__nav-{{ ai_gen_id }} {
      display: flex;
    }

    .ai-collection-carousel__wrapper-{{ ai_gen_id }} {
      padding: 0 60px;
    }
  }

  @media screen and (min-width: 990px) {
    .ai-collection-carousel__item-{{ ai_gen_id }} {
      width: calc((100% - ({{ block.settings.items_per_row_desktop | minus: 1 }} * {{ block.settings.item_spacing }}px)) / {{ block.settings.items_per_row_desktop }});
    }
  }
{% endstyle %}

<collection-carousel-{{ ai_gen_id }} class="ai-collection-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <div class="ai-collection-carousel__header-{{ ai_gen_id }}">
      <h2 class="ai-collection-carousel__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    </div>
  {% endif %}

  <div class="ai-collection-carousel__wrapper-{{ ai_gen_id }}">
    <button
      class="ai-collection-carousel__nav-{{ ai_gen_id }} ai-collection-carousel__nav--prev-{{ ai_gen_id }}"
      aria-label="Previous"
      data-nav="prev"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <div class="ai-collection-carousel__track-{{ ai_gen_id }}" data-track>
      {% for i in (1..block.settings.collection_count) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection = block.settings[collection_key]
        %}

        {% if collection != blank %}
          <div class="ai-collection-carousel__item-{{ ai_gen_id }}">
            <a href="{{ collection.url }}" class="ai-collection-carousel__card-{{ ai_gen_id }}">
              <div class="ai-collection-carousel__image-wrapper-{{ ai_gen_id }}">
                {% if collection.featured_image %}
                  <img
                    src="{{ collection.featured_image | image_url: width: 800 }}"
                    alt="{{ collection.featured_image.alt | escape }}"
                    class="ai-collection-carousel__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="800"
                    height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                  >
                {% else %}
                  <div class="ai-collection-carousel__image-placeholder-{{ ai_gen_id }}">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
                <div class="ai-collection-carousel__overlay-{{ ai_gen_id }}">
                  <h3 class="ai-collection-carousel__title-{{ ai_gen_id }}">{{ collection.title }}</h3>
                </div>
              </div>
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <button
      class="ai-collection-carousel__nav-{{ ai_gen_id }} ai-collection-carousel__nav--next-{{ ai_gen_id }}"
      aria-label="Next"
      data-nav="next"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>
</collection-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('[data-track]');
        this.prevButton = this.querySelector('[data-nav="prev"]');
        this.nextButton = this.querySelector('[data-nav="next"]');
        this.items = this.querySelectorAll('.ai-collection-carousel__item-{{ ai_gen_id }}');
        this.itemSpacing = {{ block.settings.item_spacing }};
        this.touchStartX = 0;
        this.touchEndX = 0;
        this.isDesktop = window.matchMedia('(min-width: 750px)').matches;
      }

      connectedCallback() {
        this.setupEventListeners();
        this.updateNavigationState();
      }

      setupEventListeners() {
        if (this.prevButton && this.nextButton) {
          this.prevButton.addEventListener('click', () => this.scroll('prev'));
          this.nextButton.addEventListener('click', () => this.scroll('next'));
        }

        this.track.addEventListener('scroll', () => this.updateNavigationState());

        this.track.addEventListener('touchstart', (e) => {
          this.touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });

        this.track.addEventListener('touchend', (e) => {
          this.touchEndX = e.changedTouches[0].screenX;
          this.handleSwipe();
        }, { passive: true });

        window.addEventListener('resize', () => {
          this.isDesktop = window.matchMedia('(min-width: 750px)').matches;
          this.updateNavigationState();
        });
      }

      scroll(direction) {
        if (!this.items.length) return;

        const itemWidth = this.items[0].offsetWidth;
        const scrollAmount = itemWidth + this.itemSpacing;

        if (direction === 'prev') {
          this.track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        } else {
          this.track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        }
      }

      handleSwipe() {
        const swipeThreshold = 50;
        const diff = this.touchStartX - this.touchEndX;

        if (Math.abs(diff) > swipeThreshold) {
          if (diff > 0) {
            this.scroll('next');
          } else {
            this.scroll('prev');
          }
        }
      }

      updateNavigationState() {
        if (!this.prevButton || !this.nextButton) return;

        const isAtStart = this.track.scrollLeft <= 0;
        const isAtEnd = this.track.scrollLeft + this.track.offsetWidth >= this.track.scrollWidth - 1;

        this.prevButton.disabled = isAtStart;
        this.nextButton.disabled = isAtEnd;
      }
    }

    customElements.define('collection-carousel-{{ ai_gen_id }}', CollectionCarousel{{ ai_gen_id }});
  })();
</script>

