{% doc %}
  @prompt
    Create a slim, clean hero section for TRTF Studios brand with the following elements:
    
    1. Centered heading text that says "TRTF Studios Community" 
    2. Centered subheading text that says "JOIN THOUSANDS WHO EMBRACE BOLD STREETWEAR"
    3. Three icons displayed in a row directly below the text with labels:
       - Star/badge icon with "20,000+ Customers"
       - Gift icon with "Free Mystery Item In Every Order"
       - Diamond icon with "Premium Quality"
    
    Design requirements:
    - Extremely slim and concise layout with minimal padding
    - Clean, modern aesthetic
    - Fully customizable text, icons, and colors through theme editor settings
    - Responsive design that works perfectly on both desktop and mobile
    - Icons should be evenly spaced and stack vertically on mobile
    - All text should be editable in the theme customizer
    - Minimal vertical spacing between elements for a compact look, make everything centered
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    font-weight: 700;
    text-align: center;
  }

  .ai-hero-subheading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    line-height: 1.4;
    font-weight: 500;
    letter-spacing: 0.5px;
    text-align: center;
  }

  .ai-hero-features-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.features_gap }}px;
    flex-wrap: wrap;
  }

  .ai-hero-feature-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: {{ block.settings.icon_text_gap }}px;
    flex: 0 1 auto;
    max-width: 200px;
    text-align: center;
  }

  .ai-hero-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
    flex-shrink: 0;
  }

  .ai-hero-feature-text-{{ ai_gen_id }} {
    color: {{ block.settings.feature_text_color }};
    font-size: {{ block.settings.feature_text_size }}px;
    line-height: 1.3;
    font-weight: 500;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px 16px {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-hero-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
      margin-bottom: {{ block.settings.heading_spacing_mobile }}px;
    }

    .ai-hero-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_mobile }}px;
      margin-bottom: {{ block.settings.subheading_spacing_mobile }}px;
    }

    .ai-hero-features-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.features_gap_mobile }}px;
    }

    .ai-hero-feature-{{ ai_gen_id }} {
      max-width: 100%;
    }

    .ai-hero-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
    }

    .ai-hero-feature-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.feature_text_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h1 class="ai-hero-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <p class="ai-hero-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
    {% endif %}

    <div class="ai-hero-features-{{ ai_gen_id }}">
      {% if block.settings.feature_1_enabled %}
        <div class="ai-hero-feature-{{ ai_gen_id }}">
          <svg class="ai-hero-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          {% if block.settings.feature_1_text != blank %}
            <span class="ai-hero-feature-text-{{ ai_gen_id }}">{{ block.settings.feature_1_text }}</span>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.feature_2_enabled %}
        <div class="ai-hero-feature-{{ ai_gen_id }}">
          <svg class="ai-hero-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 12 20 22 4 22 4 12"></polyline>
            <rect x="2" y="7" width="20" height="5"></rect>
            <line x1="12" y1="22" x2="12" y2="7"></line>
            <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
            <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
          </svg>
          {% if block.settings.feature_2_text != blank %}
            <span class="ai-hero-feature-text-{{ ai_gen_id }}">{{ block.settings.feature_2_text }}</span>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.feature_3_enabled %}
        <div class="ai-hero-feature-{{ ai_gen_id }}">
          <svg class="ai-hero-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
            <path d="M2 17l10 5 10-5"></path>
            <path d="M2 12l10 5 10-5"></path>
          </svg>
          {% if block.settings.feature_3_text != blank %}
            <span class="ai-hero-feature-text-{{ ai_gen_id }}">{{ block.settings.feature_3_text }}</span>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

