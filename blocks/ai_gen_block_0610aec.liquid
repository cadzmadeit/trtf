{% doc %}
  @prompt
    Create a fully customizable announcement banner with fade transitions between multiple announcements using arrow navigation. The banner should use the theme's font family in all caps with responsive font sizing that automatically scales down to keep text on one line. Include a close (X) button positioned so arrows don't cover it. The banner should be mobile-responsive, displaying promotional messages horizontally on mobile with dark background, white text and icons for "Free Shipping", "Free Mystery item", and "Secure Payments". Include comprehensive customization options for background color, text color, font size (that actually works when edited), icon selection, message text, transition speed, and show/hide options for each element. Ensure the font matches the AI-generated slideshow section and automatically adjusts size to fit content in one line., remove the fade animation. remove the close button. only make 3 announcements with no links. fix the icons., make it running with no navigation arrows, make it a running announcement as it, it keeps auto sliding to the right announcement to annoucment then repeats. seperate each announcemnet with a clean concise dot., remove the dot. make it so ITS never white. it always repeats , the announcement should start immediately and run continuously meaning there should NEVER be a point of time where text isn't displayed. copy the section called annoucement banner that you have previously made but with my new changes
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-banner-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding }}px 20px;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .ai-announcement-banner-wrapper-{{ ai_gen_id }} {
    display: flex;
    animation: ai-announcement-slide-{{ ai_gen_id }} {{ block.settings.transition_speed }}s linear infinite;
    white-space: nowrap;
  }

  .ai-announcement-banner-item-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 40px;
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    font-weight: {{ block.settings.font_family.weight }};
    font-size: {{ block.settings.font_size }}px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    flex-shrink: 0;
  }

  .ai-announcement-banner-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
  }

  .ai-announcement-banner-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.text_color }};
  }

  @keyframes ai-announcement-slide-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-33.333%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-banner-item-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.8 }}px;
      padding: 0 30px;
    }

    .ai-announcement-banner-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-announcement-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-announcement-banner-wrapper-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign announcement_enabled_key = 'announcement_' | append: i | append: '_enabled'
        assign announcement_text_key = 'announcement_' | append: i | append: '_text'
        assign announcement_icon_key = 'announcement_' | append: i | append: '_icon'

        assign announcement_enabled = block.settings[announcement_enabled_key]
        assign announcement_text = block.settings[announcement_text_key]
        assign announcement_icon = block.settings[announcement_icon_key]
      %}

      {% if announcement_enabled and announcement_text != blank %}
        <div class="ai-announcement-banner-item-{{ ai_gen_id }}">
          {% if announcement_icon != 'none' %}
            <span class="ai-announcement-banner-icon-{{ ai_gen_id }}">
              {% if announcement_icon == 'shipping' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="1" y="3" width="15" height="13"></rect>
                  <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                  <circle cx="5.5" cy="18.5" r="2.5"></circle>
                  <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
              {% elsif announcement_icon == 'gift' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 12 20 22 4 22 4 12"></polyline>
                  <rect x="2" y="7" width="20" height="5"></rect>
                  <line x1="12" y1="22" x2="12" y2="7"></line>
                  <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                  <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
                </svg>
              {% elsif announcement_icon == 'secure' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <path d="M9 12l2 2 4-4"></path>
                </svg>
              {% endif %}
            </span>
