{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  html, body {
    overflow-x: hidden !important;
    width: 100%;
    max-width: 100vw;
    position: relative;
  }

  .ai-slideshow-wrapper-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100vw;
    overflow-x: hidden;
    position: relative;
    box-sizing: border-box;
  }

  .ai-slideshow-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100vw;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }

  .ai-slideshow-container-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
    width: 100%;
    max-width: 100vw;
    box-sizing: border-box;
  }

  .ai-slide-{{ ai_gen_id }} {
    flex: 0 0 100%;
    width: 100%;
    max-width: 100vw;
    position: relative;
    box-sizing: border-box;
  }

  .ai-slide-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_ratio }}%;
    overflow: hidden;
  }

  .ai-slide-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-slide-subheading-{{ ai_gen_id }} {
    position: absolute;
    top: 20px;
    left: 20px;
    margin: 0;
    font-size: calc({{ block.settings.subheading_size }}px * 0.8);
    line-height: 1.4;
    color: {{ block.settings.subheading_color }};
    z-index: 2;
  }

  .ai-slide-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px;
    text-align: {{ block.settings.text_alignment }};
    color: {{ block.settings.text_color }};
    background: linear-gradient(0deg, {{ block.settings.overlay_color }} 0%, rgba(0,0,0,0) 100%);
  }

  .ai-slide-heading-{{ ai_gen_id }} {
    margin: 0 0 15px 0;
    font-size: calc({{ block.settings.heading_size }}px * 0.8);
    font-weight: 700;
    line-height: 1.2;
    color: {{ block.settings.heading_color }};
  }

  .ai-slide-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 10px 20px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: 600;
    text-transform: {{ block.settings.button_text_transform }};
    transition: background-color 0.3s ease, transform 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-slide-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_color }};
    transform: translateY(-2px);
  }

  .ai-slideshow-nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    margin-top: 20px;
    gap: 10px;
  }

  .ai-slideshow-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.5;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .ai-slideshow-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-slideshow-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.nav_button_background }};
    color: {{ block.settings.nav_button_color }};
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.3s ease;
    z-index: 1;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
  }

  .ai-slideshow-button-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-slideshow-prev-{{ ai_gen_id }} {
    left: 10px;
  }

  .ai-slideshow-next-{{ ai_gen_id }} {
    right: 10px;
  }

  @media screen and (min-width: 750px) {
    .ai-slideshow-container-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: repeat({{ block.settings.desktop_columns }}, 1fr);
      grid-gap: {{ block.settings.desktop_gap }}px;
    }

    .ai-slide-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size }}px;
    }

    .ai-slide-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size }}px;
    }

    .ai-slideshow-nav-{{ ai_gen_id }} {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-slide-{{ ai_gen_id }},
    .ai-slideshow-container-{{ ai_gen_id }},
    .ai-slideshow-{{ ai_gen_id }},
    .ai-slideshow-wrapper-{{ ai_gen_id }} {
      max-width: 100vw !important;
      overflow-x: hidden !important;
      box-sizing: border-box;
    }
  }
{% endstyle %}

<!-- WRAPPER LOCKS WIDTH -->
<div class="ai-slideshow-wrapper-{{ ai_gen_id }}">
  <div class="ai-slideshow-{{ ai_gen_id }}">
    <!-- Keep your slide logic and navigation here -->
  </div>
</div>

{% schema %}
{
  "name": "Responsive Slideshow",
  "tag": "section",
  "settings": []
}
{% endschema %}
