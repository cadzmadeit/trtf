{% doc %}
  @prompt
    Create a premium Shopify announcement bar section inspired by luxury streetwear brands. The section should be a fully responsive infinite scrolling marquee with smooth continuous movement from right to left.
    DESIGN STYLE:
    
    
    Black background (#000000)
    
    
    White uppercase text
    
    
    Tight letter spacing
    
    
    Bold condensed luxury/streetwear aesthetic
    
    
    Height around 40-50px desktop and slightly smaller on mobile
    
    
    Clean minimal look
    
    
    The separator icon between messages should NOT be a star
    
    
    Instead use a custom T-shaped gothic cross icon (luxury chrome-hearts inspired style)
    
    
    Cross should be vertically centered and slightly smaller than the text
    
    
    FUNCTIONALITY:
    
    
    Infinite seamless marquee effect with NO visible gaps or jumps
    
    
    Smooth CSS animation
    
    
    Adjustable scroll speed in theme editor
    
    
    Pause on hover toggle
    
    
    Mobile responsive
    
    
    No horizontal overflow bugs on mobile
    
    
    Text should never wrap
    
    
    Marquee content duplicated automatically for seamless looping
    
    
    CUSTOMIZATION OPTIONS IN SHOPIFY EDITOR:
    
    
    Announcement text
    
    
    Background color
    
    
    Text color
    
    
    Cross icon color
    
    
    Font size desktop
    
    
    Font size mobile
    
    
    Font weight
    
    
    Letter spacing
    
    
    Scroll speed range slider
    
    
    Bar height
    
    
    Pause on hover checkbox
    
    
    Enable/disable marquee
    
    
    Text transform (uppercase toggle)
    
    
    Separator spacing
    
    
    Padding left/right
    
    
    ADVANCED FEATURES:
    
    
    Allow multiple announcement messages as blocks
    
    
    Automatically insert cross separator between blocks
    
    
    Support links per announcement block
    
    
    Smooth performance with GPU accelerated transforms
    
    
    Use pure CSS animation if possible
    
    
    Prevent layout shifts
    
    
    Should work perfectly in Dawn theme and most Shopify themes
    
    
    SECTION REQUIREMENTS:
    
    
    Create as a Shopify section file
    
    
    Include full Liquid, CSS, schema, and minimal JS only if necessary
    
    
    Use semantic class naming
    
    
    Code should be clean and optimized
    
    
    Avoid unnecessary wrappers
    
    
    Ensure accessibility
    
    
    Mobile should look identical proportionally to desktop
    
    
    ICON REQUIREMENT:
    Use an inline SVG for the separator icon shaped like a gothic T-style cross, NOT a regular Christian cross and NOT a star. The style should feel luxury, edgy, and minimal. 
    
    make sure the desktop view is also optimized so the text doesnt cut off.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
    position: relative;
    height: {{ block.settings.bar_height_desktop }}px;
  }

  .ai-marquee-bar-{{ ai_gen_id }}__wrapper {
    display: flex;
    align-items: center;
    height: 100%;
    width: fit-content;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    will-change: transform;
    {% if block.settings.pause_on_hover %}
      animation-play-state: running;
    {% endif %}
  }

  {% if block.settings.pause_on_hover %}
    .ai-marquee-bar-{{ ai_gen_id }}:hover .ai-marquee-bar-{{ ai_gen_id }}__wrapper {
      animation-play-state: paused;
    }
  {% endif %}

  .ai-marquee-bar-{{ ai_gen_id }}__content {
    display: flex;
    align-items: center;
    white-space: nowrap;
    padding: 0 {{ block.settings.padding_horizontal }}px;
  }

  .ai-marquee-bar-{{ ai_gen_id }}__item {
    display: inline-flex;
    align-items: center;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size_desktop }}px;
    font-weight: {{ block.settings.font_weight }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
    {% if block.settings.text_uppercase %}
      text-transform: uppercase;
    {% endif %}
    text-decoration: none;
  }

  .ai-marquee-bar-{{ ai_gen_id }}__separator {
    display: inline-flex;
    align-items: center;
    margin: 0 {{ block.settings.separator_spacing }}px;
    color: {{ block.settings.cross_color }};
    flex-shrink: 0;
  }

  .ai-marquee-bar-{{ ai_gen_id }}__separator svg {
    width: {{ block.settings.font_size_desktop | times: 0.8 }}px;
    height: {{ block.settings.font_size_desktop | times: 0.8 }}px;
    fill: currentColor;
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-marquee-bar-{{ ai_gen_id }} {
      height: {{ block.settings.bar_height_mobile }}px;
    }

    .ai-marquee-bar-{{ ai_gen_id }}__item {
      font-size: {{ block.settings.font_size_mobile }}px;
    }

    .ai-marquee-bar-{{ ai_gen_id }}__separator svg {
      width: {{ block.settings.font_size_mobile | times: 0.8 }}px;
      height: {{ block.settings.font_size_mobile | times: 0.8 }}px;
    }
  }
{% endstyle %}

<marquee-bar-{{ ai_gen_id }} class="ai-marquee-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-marquee-bar-{{ ai_gen_id }}__wrapper">
    {% liquid
      capture marquee_content
        assign messages = ''
        assign message_count = 0

        if block.settings.message_1 != blank
          assign messages = messages | append: block.settings.message_1
          assign message_count = message_count | plus: 1
        endif

        if block.settings.message_2 != blank
          if message_count > 0
            assign messages = messages | append: '|||'
          endif
          assign messages = messages | append: block.settings.message_2
          assign message_count = message_count | plus: 1
        endif

        if block.settings.message_3 != blank
          if message_count > 0
            assign messages = messages | append: '|||'
          endif
          assign messages = messages | append: block.settings.message_3
          assign message_count = message_count | plus: 1
        endif

        if block.settings.message_4 != blank
          if message_count > 0
            assign messages = messages | append: '|||'
          endif
          assign messages = messages | append: block.settings.message_4
          assign message_count = message_count | plus: 1
        endif

        if block.settings.message_5 != blank
          if message_count > 0
            assign messages = messages | append: '|||'
          endif
          assign messages = messages | append: block.settings.message_5
          assign message_count = message_count | plus: 1
        endif

        assign message_array = messages | split: '|||'

        for message in message_array
          if block.settings.link_url != blank
            echo '<a href="' | append: block.settings.link_url | append: '" class="ai-marquee-bar-' | append: ai_gen_id | append: '__item">'
            echo message
            echo '</a>'
          else
            echo '<span class="ai-marquee-bar-' | append: ai_gen_id | append: '__item">'
            echo message
            echo '</span>'
          endif
          
          unless forloop.last
            echo '<span class="ai-marquee-bar-' | append: ai_gen_id | append: '__separator">'
            echo '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2L10 8H14L12 2Z"/><path d="M10 8H14V16H10V8Z"/><path d="M8 16H16V18H8V16Z"/><path d="M9 18H15V22H9V18Z"/></svg>'
            echo '</span>'
          endunless
        endfor
      endcapture
    %}

    <div class="ai-marquee-bar-{{ ai_gen_id }}__content">
      {{ marquee_content }}
      <span class="ai-marquee-bar-{{ ai_gen_id }}__separator">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M12 2L10 8H14L12 2Z"/>
          <path d="M10 8H14V16H10V8Z"/>
          <path d="M8 16H16V18H8V16Z"/>
          <path d="M9 18H15V22H9V18Z"/>
        </svg>
      </span>
    </div>

    <div class="ai-marquee-bar-{{ ai_gen_id }}__content" aria-hidden="true">
      {{ marquee_content }}
      <span class="ai-marquee-bar-{{ ai_gen_id }}__separator">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M12 2L10 8H14L12 2Z"/>
          <path d="M10 8H14V16H10V8Z"/>
          <path d="M8 16H16V18H8V16Z"/>
          <path d="M9 18H15V22H9V18Z"/>
        </svg>
      </span>
    </div>
  </div>
</marquee-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class MarqueeBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.adjustAnimationSpeed();
      }

      adjustAnimationSpeed() {
        const wrapper = this.querySelector('.ai-marquee-bar-{{ ai_gen_id }}__wrapper');
        if (!wrapper) return;

        const content = wrapper.querySelector('.ai-marquee-bar-{{ ai_gen_id }}__content');
        if (!content) return;

        const contentWidth = content.offsetWidth;
        const speed = {{ block.settings.scroll_speed }};
        const duration = (contentWidth / 100) * speed;

        wrapper.style.animationDuration = duration + 's';
      }
    }

    customElements.define('marquee-bar-{{ ai_gen_id }}', MarqueeBar{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Luxury marquee bar",
  "tag": null,
  "class": "ai-marquee-announcement-bar",
  "settings": [
    {
      "type": "header",
      "content": "Messages"
    },
    {
      "type": "text",
      "id": "message_1",
      "label": "Message 1",
      "default": "Free shipping worldwide"
    },
    {
      "type": "text",
      "id": "message_2",
      "label": "Message 2",
      "default": "New collection dropping soon"
    },
    {
      "type": "text",
      "id": "message_3",
      "label": "Message 3",
      "default": "Limited edition pieces available"
    },
    {
      "type": "text",
      "id": "message_4",
      "label": "Message 4"
    },
    {
      "type": "text",
      "id": "message_5",
      "label": "Message 5"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "bar_height_desktop",
      "label": "Bar height desktop",
      "min": 30,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 45
    },
    {
      "type": "range",
      "id": "bar_height_mobile",
      "label": "Bar height mobile",
      "min": 25,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 35
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cross_color",
      "label": "Cross icon",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "label": "Font size desktop",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font size mobile",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "text_uppercase",
      "label": "Uppercase text",
      "default": true
