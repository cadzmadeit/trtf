{% doc %}
  @prompt
    Create a custom product carousel slider with a horizontal progress bar indicator that shows scroll position. The carousel should display product cards with images, titles, prices, sale prices, color swatches, and badges (like "BEST SELLER", "NEW COLORS", "NEW ARRIVAL"). Include smooth horizontal scrolling, navigation arrows, and make it fully customizable with options for number of products to show, spacing, colors, and section title. The carousel should work as both a featured products section and a "you may also like" recommendations section on product pages. Include settings to customize the progress bar color and position. make it so the entire image is clickable and goes to the product. make the slider look clean and concise and fit the layout of the site. if there is 2 or less products then make the navigation arrows be able to be turned off. also make it so theres no slider when theres 2 or less products, keep everything the same just add a subtitle section as well that has the same customizables
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-carousel-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-product-carousel-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-product-carousel-header-{{ ai_gen_id }} {
    margin-bottom: 32px;
    text-align: {{ block.settings.title_alignment }};
  }

  .ai-product-carousel-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 8px 0;
    font-weight: 700;
  }

  .ai-product-carousel-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    font-weight: 400;
  }

  .ai-product-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-product-carousel-track-container-{{ ai_gen_id }} {
    overflow: hidden;
    position: relative;
  }

  .ai-product-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.product_spacing }}px;
    transition: transform 0.4s ease;
    scroll-behavior: smooth;
  }

  .ai-product-carousel-track-{{ ai_gen_id }}.no-scroll {
    justify-content: center;
  }

  .ai-product-card-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.products_per_row }} - 1) * {{ block.settings.product_spacing }}px) / {{ block.settings.products_per_row }});
    min-width: 0;
  }

  .ai-product-card-inner-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .ai-product-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    margin-bottom: 12px;
    background-color: #f6f6f6;
    aspect-ratio: 1 / 1;
  }

  .ai-product-card-image-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ai-product-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-product-card-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: {{ block.settings.badge_background_color }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-radius: 4px;
    z-index: 2;
  }

  .ai-product-card-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-product-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0;
    font-weight: 500;
    line-height: 1.3;
  }

  .ai-product-card-title-link-{{ ai_gen_id }} {
    color: inherit;
    text-decoration: none;
  }

  .ai-product-card-title-link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-product-card-price-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
  }

  .ai-product-card-price-regular-{{ ai_gen_id }} {
    font-weight: 600;
  }

  .ai-product-card-price-compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    font-size: 0.9em;
  }

  .ai-product-card-price-sale-{{ ai_gen_id }} {
    color: {{ block.settings.sale_price_color }};
  }

  .ai-product-card-swatches-{{ ai_gen_id }} {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .ai-product-card-swatch-{{ ai_gen_id }} {
    width: {{ block.settings.swatch_size }}px;
    height: {{ block.settings.swatch_size }}px;
    border-radius: 50%;
    border: 2px solid {{ block.settings.swatch_border_color }};
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .ai-product-card-swatch-{{ ai_gen_id }}:hover {
    transform: scale(1.1);
  }

  .ai-carousel-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.arrow_background_color }};
    color: {{ block.settings.arrow_color }};
    border: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-carousel-nav-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_background_color }};
    transform: translateY(-50%) scale(1.05);
  }

  .ai-carousel-nav-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-carousel-nav-{{ ai_gen_id }}:disabled:hover {
    transform: translateY(-50%);
  }

  .ai-carousel-nav-prev-{{ ai_gen_id }} {
    left: -22px;
  }

  .ai-carousel-nav-next-{{ ai_gen_id }} {
    right: -22px;
  }

  .ai-carousel-nav-{{ ai_gen_id }}.hidden {
    display: none;
  }

  .ai-carousel-nav-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-carousel-progress-container-{{ ai_gen_id }} {
    margin-top: {{ block.settings.progress_bar_spacing }}px;
    {% if block.settings.progress_bar_position == 'top' %}
      order: -1;
      margin-top: 0;
      margin-bottom: {{ block.settings.progress_bar_spacing }}px;
    {% endif %}
  }

  .ai-carousel-progress-bar-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.progress_bar_height }}px;
    background-color: {{ block.settings.progress_bar_background_color }};
    border-radius: {{ block.settings.progress_bar_height | divided_by: 2 }}px;
    overflow: hidden;
  }

  .ai-carousel-progress-fill-{{ ai_gen_id }} {
    height: 100%;
    background-color: {{ block.settings.progress_bar_color }};
    transition: width 0.4s ease;
    border-radius: {{ block.settings.progress_bar_height | divided_by: 2 }}px;
  }

  @media screen and (max-width: 989px) {
    .ai-product-card-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.products_per_row_tablet }} - 1) * {{ block.settings.product_spacing }}px) / {{ block.settings.products_per_row_tablet }});
    }

    .ai-carousel-nav-prev-{{ ai_gen_id }} {
      left: 10px;
    }

    .ai-carousel-nav-next-{{ ai_gen_id }} {
      right: 10px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-product-card-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.products_per_row_mobile }} - 1) * {{ block.settings.product_spacing }}px) / {{ block.settings.products_per_row_mobile }});
    }

    .ai-product-carousel-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-product-carousel-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.8 }}px;
    }

    .ai-carousel-nav-{{ ai_gen_id }} {
      width: 36px;
      height: 36px;
    }

    .ai-carousel-nav-{{ ai_gen_id }} svg {
      width: 16px;
      height: 16px;
    }
  }
{% endstyle %}

<product-carousel-{{ ai_gen_id }} class="ai-product-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-carousel-container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank or block.settings.section_subtitle != blank %}
      <div class="ai-product-carousel-header-{{ ai_gen_id }}">
        {% if block.settings.section_title != blank %}
          <h2 class="ai-product-carousel-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
        {% endif %}
        {% if block.settings.section_subtitle != blank %}
          <p class="ai-product-carousel-subtitle-{{ ai_gen_id }}">{{ block.settings.section_subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-product-carousel-wrapper-{{ ai_gen_id }}" style="display: flex; flex-direction: column;">
      {% if block.settings.progress_bar_position == 'top' %}
        <div class="ai-carousel-progress-container-{{ ai_gen_id }}">
          <div class="ai-carousel-progress-bar-{{ ai_gen_id }}">
            <div class="ai-carousel-progress-fill-{{ ai_gen_id }}" style="width: 0%;"></div>
          </div>
        </div>
      {% endif %}

      <div style="position: relative;">
        <div class="ai-product-carousel-track-container-{{ ai_gen_id }}">
          <div class="ai-product-carousel-track-{{ ai_gen_id }}">
            {% if block.settings.product_list != blank %}
              {% for product in block.settings.product_list %}
                <div class="ai-product-card-{{ ai_gen_id }}">
                  <div class="ai-product-card-inner-{{ ai_gen_id }}">
                    <div class="ai-product-card-image-wrapper-{{ ai_gen_id }}">
                      <a href="{{ product.url }}" class="ai-product-card-image-link-{{ ai_gen_id }}">
                        {% if product.featured_image %}
                          <img
                            src="{{ product.featured_image | image_url: width: 600 }}"
                            alt="{{ product.featured_image.alt | escape }}"
                            class="ai-product-card-image-{{ ai_gen_id }}"
                            loading="lazy"
                            width="600"
                            height="600"
                          >
                        {% else %}
                          <div class="ai-product-card-image-placeholder-{{ ai_gen_id }}">
                            {{ 'product-1' | placeholder_svg_tag }}
                          </div>
                        {% endif %}
                      </a>

                      {% if block.settings.show_badges %}
                        {% if product.tags contains 'best-seller' or product.tags contains 'bestseller' %}
                          <div class="ai-product-card-badge-{{ ai_gen_id }}">Best Seller</div>
                        {% elsif product.tags contains 'new-colors' %}
                          <div class="ai-product-card-badge-{{ ai_gen_id }}">New Colors</div>
                        {% elsif product.tags contains 'new-arrival' or product.tags contains 'new' %}
                          <div class="ai-product-card-badge-{{ ai_gen_id }}">New Arrival</div>
                        {% endif %}
                      {% endif %}
                    </div>

                    <div class="ai-product-card-info-{{ ai_gen_id }}">
                      <h3 class="ai-product-card-title-{{ ai_gen_id }}">
                        <a href="{{ product.url }}" class="ai-product-card-title-link-{{ ai_gen_id }}">
                          {{ product.title }}
                        </a>
                      </h3>

                      <div class="ai-product-card-price-{{ ai_gen_id }}">
                        {% if product.compare_at_price > product.price %}
                          <span class="ai-product-card-price-sale-{{ ai_gen_id }} ai-product-card-price-regular-{{ ai_gen_id }}">
                            {{ product.price | money }}
                          </span>
                          <span class="ai-product-card-price-compare-{{ ai_gen_id }}">
                            {{ product.compare_at_price | money }}
                          </span>
                        {% else %}
                          <span class="ai-product-card-price-regular-{{ ai_gen_id }}">
                            {{ product.price | money }}
                          </span>
                        {% endif %}
                      </div>

                      {% if block.settings.show_color_swatches %}
                        {% for option in product.options_with_values %}
                          {% assign option_name_downcase = option.name | downcase %}
                          {% if option_name_downcase == 'color' or option_name_downcase == 'colour' %}
                            <div class="ai-product-card-swatches-{{ ai_gen_id }}">
                              {% for value in option.values limit: block.settings.max_swatches %}
                                {% assign color_value = value | downcase | replace: ' ', '-' %}
                                <div
                                  class="ai-product-card-swatch-{{ ai_gen_id }}"
                                  style="background-color: {{ color_value }};"
                                  title="{{ value }}"
                                ></div>
                              {% endfor %}
                            </div>
                            {% break %}
                          {% endif %}
                        {% endfor %}
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endfor %}
            {% else %}
              {% for i in (1..6) %}
                <div class="ai-product-card-{{ ai_gen_id }}">
                  <div class="ai-product-card-inner-{{ ai_gen_id }}">
                    <div class="ai-product-card-image-wrapper-{{ ai_gen_id }}">
                      <div class="ai-product-card-image-placeholder-{{ ai_gen_id }}">
                        {{ 'product-1' | placeholder_svg_tag }}
                      </div>
                    </div>
                    <div class="ai-product-card-info-{{ ai_gen_id }}">
                      <h3 class="ai-product-card-title-{{ ai_gen_id }}">Product Title</h3>
                      <div class="ai-product-card-price-{{ ai_gen_id }}">
                        <span class="ai-product-card-price-regular-{{ ai_gen_id }}">$29.99</span>
                      </div>
                    </div>
                  </div>
                </div>
              {% endfor %}
            {% endif %}
          </div>
        </div>

        <button
          class="ai-carousel-nav-{{ ai_gen_id }} ai-carousel-nav-prev-{{ ai_gen_id }}"
          aria-label="Previous products"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <button
          class="ai-carousel-nav-{{ ai_gen_id }} ai-carousel-nav-next-{{ ai_gen_id }}"
          aria-label="Next products"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>

      {% if block.settings.progress_bar_position == 'bottom' %}
        <div class="ai-carousel-progress-container-{{ ai_gen_id }}">
          <div class="ai-carousel-progress-bar-{{ ai_gen_id }}">
            <div class="ai-carousel-progress-fill-{{ ai_gen_id }}" style="width: 0%;"></div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</product-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('.ai-product-carousel-track-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-carousel-nav-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-carousel-nav-next-{{ ai_gen_id }}');
        this.progressFill = this.querySelector('.ai-carousel-progress-fill-{{ ai_gen_id }}');
        this.cards = this.querySelectorAll('.ai-product-card-{{ ai_gen_id }}');
        this.currentIndex = 0;
        this.hideArrowsWhenFewProducts = {{ block.settings.hide_arrows_few_products }};
      }

      connectedCallback() {
        if (this.cards.length <= 2) {
          this.track.classList.add('no-scroll');
          if (this.hideArrowsWhenFewProducts) {
            this.prevButton.classList.add('hidden');
            this.nextButton.classList.add('hidden');
          }
          this.updateProgress();
          return;
        }

        this.setupEventListeners();
        this.updateButtons();
        this.updateProgress();
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.slide(-1));
        this.nextButton.addEventListener('click', () => this.slide(1));

        let resizeTimer;
        window.addEventListener('resize', () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => {
            this.currentIndex = 0;
            this.updateCarousel();
          }, 250);
        });
      }

      getVisibleCards() {
        const width = window.innerWidth;
        if (width <= 749) {
          return {{ block.settings.products_per_row_mobile }};
        }
        if (width <= 989) {
          return {{ block.settings.products_per_row_tablet }};
        }
        return {{ block.settings.products_per_row }};
      }

      slide(direction) {
        const visibleCards = this.getVisibleCards();
        const maxIndex = Math.max(0, this.cards.length - visibleCards);

        this.currentIndex += direction;
        this.currentIndex = Math.max(0, Math.min(this.currentIndex, maxIndex));

        this.updateCarousel();
      }

      updateCarousel() {
        if (this.cards.length === 0) return;

        const cardWidth = this.cards[0].offsetWidth;
        const gap = {{ block.settings.product_spacing }};
        const offset = this.currentIndex * (cardWidth + gap);

        this.track.style.transform = `translateX(-${offset}px)`;
        this.updateButtons();
        this.updateProgress();
      }

      updateButtons() {
        const visibleCards = this.getVisibleCards();
        const maxIndex = Math.max(0, this.cards.length - visibleCards);

        this.prevButton.disabled = this.currentIndex === 0;
        this.nextButton.disabled = this.currentIndex >= maxIndex;
      }

      updateProgress() {
        const visibleCards = this.getVisibleCards();
        const totalCards = this.cards.length;

        if (totalCards <= visibleCards) {
          this.progressFill.style.width = '100%';
          return;
        }

        const maxIndex = totalCards - visibleCards;
        const progress = maxIndex > 0 ? (this.currentIndex / maxIndex) * 100 : 0;
        this.progressFill.style.width = `${progress}%`;
      }
    }

    customElements.define('product-carousel-{{ ai_gen_id }}', ProductCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product carousel",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section title",
      "default": "Featured Products"
    },
    {
      "type": "text",
      "id": "section_subtitle",
      "label": "Section subtitle",
      "default": "Discover our handpicked selection"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products",
      "limit": 12
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show product badges",
      "default": true,
      "info": "Add tags like 'best-seller', 'new-colors', or 'new-arrival' to products"
    },
    {
      "type": "checkbox",
      "id": "show_color_swatches",
      "label": "Show color swatches",
      "default": true
    },
    {
      "type": "range",
      "id": "max_swatches",
      "min": 3,
      "max": 10,
      "step": 1,
      "label": "Maximum swatches",
      "default": 5
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 1000,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Container width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "products_per_row",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Products per row (desktop)",
      "default": 4
    },
    {
      "type": "range",
      "id": "products_per_row_tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Products per row (tablet)",
      "default": 3
    },
    {
      "type": "select",
      "id": "products_per_row_mobile",
      "label": "Products per row (mobile)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "product_spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Product spacing",
      "default": 20
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Title alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "hide_arrows_few_products",
      "label": "Hide arrows when 2 or fewer products",
      "default": true
    },
    {
      "type": "color",
      "id": "arrow_background_color",
      "label": "Arrow background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "arrow_hover_background_color",
      "label": "Arrow hover background",
      "default": "#f6f6f6"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow color",
      "default": "#141414"
    },
    {
      "type": "header",
      "content": "Progress bar"
    },
    {
      "type": "select",
      "id": "progress_bar_position",
      "label": "Position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "bottom"
    },
    {
      "type": "range",
      "id": "progress_bar_height",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Height",
      "default": 4
    },
    {
      "type": "range",
      "id": "progress_bar_spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Spacing",
      "default": 20
    },
    {
      "type": "color",
      "id": "progress_bar_color",
      "label": "Progress color",
      "default": "#141414"
    },
    {
      "type": "color",
      "id": "progress_bar_background_color",
      "label": "Background color",
      "default": "#eaeaea"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
