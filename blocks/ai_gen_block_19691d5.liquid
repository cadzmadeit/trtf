{% doc %}
  @prompt
    Create a fully customizable announcement banner with fade transitions between multiple announcements using arrow navigation. The banner should use the theme's font family in all caps with responsive font sizing that automatically scales down to keep text on one line. Include a close (X) button positioned so arrows don't cover it. The banner should be mobile-responsive, displaying promotional messages horizontally on mobile with dark background, white text and icons for "Free Shipping", "Free Mystery item", and "Secure Payments". Include comprehensive customization options for background color, text color, font size (that actually works when edited), icon selection, message text, transition speed, and show/hide options for each element. Ensure the font matches the AI-generated slideshow section and automatically adjusts size to fit content in one line., now just make the icons better, make the font size adjustable. the words should say, free shipping, free mystery item, and secure payments, make the font size be able to go even smaller, make the text the same size as the custom banner section. make the size of the section very slim and concise. make it adjustable
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
    padding: {{ block.settings.banner_padding }}px 0;
  }

  .ai-announcement-banner-container-{{ ai_gen_id }} {
    max-width: 100%;
    margin: 0 auto;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 0 60px;
  }

  .ai-announcement-banner-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: {{ block.settings.text_color }};
    cursor: pointer;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .ai-announcement-banner-nav-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-announcement-banner-nav-{{ ai_gen_id }}--prev {
    left: 10px;
  }

  .ai-announcement-banner-nav-{{ ai_gen_id }}--next {
    right: 10px;
  }

  .ai-announcement-banner-nav-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-announcement-banner-close-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    right: 40px;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: {{ block.settings.text_color }};
    cursor: pointer;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 4;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .ai-announcement-banner-close-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-announcement-banner-close-{{ ai_gen_id }} svg {
    width: 18px;
    height: 18px;
  }

  .ai-announcement-banner-content-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: 1200px;
    overflow: hidden;
  }

  .ai-announcement-banner-slides-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-announcement-banner-slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity {{ block.settings.transition_speed }}ms ease-in-out, visibility {{ block.settings.transition_speed }}ms ease-in-out;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
    flex-wrap: wrap;
  }

  .ai-announcement-banner-slide-{{ ai_gen_id }}.active {
    position: relative;
    opacity: 1;
    visibility: visible;
  }

  .ai-announcement-banner-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }

  .ai-announcement-banner-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_color }};
  }

  .ai-announcement-banner-icon-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
  }

  .ai-announcement-banner-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    font-weight: {{ block.settings.font_family.weight }};
    font-style: {{ block.settings.font_family.style }};
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1.2;
    font-size: {{ block.settings.font_size }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-banner-container-{{ ai_gen_id }} {
      padding: 0 50px;
    }

    .ai-announcement-banner-close-{{ ai_gen_id }} {
      right: 30px;
    }

    .ai-announcement-banner-nav-{{ ai_gen_id }}--prev {
      left: 5px;
    }

    .ai-announcement-banner-nav-{{ ai_gen_id }}--next {
      right: 5px;
    }

    .ai-announcement-banner-slide-{{ ai_gen_id }} {
      gap: 24px;
    }

    .ai-announcement-banner-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_mobile }}px;
    }

    .ai-announcement-banner-icon-{{ ai_gen_id }} svg {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
    }
  }
{% endstyle %}

