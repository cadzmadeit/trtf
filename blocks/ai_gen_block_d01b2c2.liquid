{% doc %}
  @prompt
    Create a custom product carousel slider with a horizontal progress bar indicator that shows scroll position. The carousel should display product cards with images, titles, prices, sale prices, color swatches, and badges (like "BEST SELLER", "NEW COLORS", "NEW ARRIVAL"). Include smooth horizontal scrolling, navigation arrows, and make it fully customizable with options for number of products to show, spacing, colors, and section title. The carousel should work as both a featured products section and a "you may also like" recommendations section on product pages. Include settings to customize the progress bar color and position.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-carousel-{{ ai_gen_id }} {
    position: relative;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-product-carousel-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-product-carousel-header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.title_spacing }}px;
    text-align: {{ block.settings.title_alignment }};
  }

  .ai-product-carousel-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    font-weight: 700;
  }

  .ai-product-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-product-carousel-track-container-{{ ai_gen_id }} {
    overflow: hidden;
    position: relative;
  }

  .ai-product-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_spacing }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 10px 0;
  }

  .ai-product-carousel-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-product-card-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.products_per_row_desktop | minus: 1 }} * {{ block.settings.card_spacing }}px)) / {{ block.settings.products_per_row_desktop }});
    min-width: 0;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-product-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 125%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-product-card-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-card-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-radius: 4px;
    z-index: 2;
  }

  .ai-product-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-product-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    font-weight: 600;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .ai-product-card-title-link-{{ ai_gen_id }} {
    color: inherit;
    text-decoration: none;
  }

  .ai-product-card-title-link-{{ ai_gen_id }}:hover {
    text-decoration: underline;
  }

  .ai-product-card-price-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .ai-product-card-price-regular-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 600;
  }

  .ai-product-card-price-compare-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size | times: 0.9 }}px;
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
  }

  .ai-product-card-price-sale-{{ ai_gen_id }} {
    color: {{ block.settings.sale_price_color }};
  }

  .ai-product-card-swatches-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .ai-product-card-swatch-{{ ai_gen_id }} {
    width: {{ block.settings.swatch_size }}px;
    height: {{ block.settings.swatch_size }}px;
    border-radius: 50%;
    border: 2px solid {{ block.settings.swatch_border_color }};
    cursor: pointer;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .ai-product-card-swatch-{{ ai_gen_id }}:hover {
    transform: scale(1.1);
    border-color: {{ block.settings.swatch_hover_border }};
  }

  .ai-carousel-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    background-color: {{ block.settings.arrow_background }};
    color: {{ block.settings.arrow_color }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: background-color 0.3s ease, transform 0.2s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .ai-carousel-nav-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_background }};
    transform: translateY(-50%) scale(1.1);
  }

  .ai-carousel-nav-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-carousel-nav-{{ ai_gen_id }}:disabled:hover {
    transform: translateY(-50%) scale(1);
  }

  .ai-carousel-nav-prev-{{ ai_gen_id }} {
    left: -{{ block.settings.arrow_size | divided_by: 2 }}px;
  }

  .ai-carousel-nav-next-{{ ai_gen_id }} {
    right: -{{ block.settings.arrow_size | divided_by: 2 }}px;
  }

  .ai-carousel-nav-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-carousel-progress-wrapper-{{ ai_gen_id }} {
    margin-top: {{ block.settings.progress_spacing }}px;
  }

  .ai-carousel-progress-bar-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.progress_height }}px;
    background-color: {{ block.settings.progress_background }};
    border-radius: {{ block.settings.progress_height | divided_by: 2 }}px;
    overflow: hidden;
  }

  .ai-carousel-progress-fill-{{ ai_gen_id }} {
    height: 100%;
    background-color: {{ block.settings.progress_color }};
    transition: width 0.3s ease;
    border-radius: {{ block.settings.progress_height | divided_by: 2 }}px;
  }

  @media screen and (max-width: 989px) {
    .ai-product-card-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.products_per_row_tablet | minus: 1 }} * {{ block.settings.card_spacing }}px)) / {{ block.settings.products_per_row_tablet }});
    }

    .ai-carousel-nav-prev-{{ ai_gen_id }} {
      left: 10px;
    }

    .ai-carousel-nav-next-{{ ai_gen_id }} {
      right: 10px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-product-card-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - {{ block.settings.card_spacing }}px) / 2);
    }

    .ai-product-carousel-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-product-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.product_title_size | times: 0.9 }}px;
    }

    .ai-carousel-nav-{{ ai_gen_id }} {
      width: {{ block.settings.arrow_size | times: 0.8 }}px;
      height: {{ block.settings.arrow_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<product-carousel-{{ ai_gen_id }} class="ai-product-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-carousel-container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank %}
      <div class="ai-product-carousel-header-{{ ai_gen_id }}">
        <h2 class="ai-product-carousel-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
      </div>
    {% endif %}

    <div class="ai-product-carousel-wrapper-{{ ai_gen_id }}">
      <button
        class="ai-carousel-nav-{{ ai_gen_id }} ai-carousel-nav-prev-{{ ai_gen_id }}"
        aria-label="Previous products"
        data-nav="prev"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="ai-product-carousel-track-container-{{ ai_gen_id }}">
        <div class="ai-product-carousel-track-{{ ai_gen_id }}" data-track>
          {% if block.settings.product_list != blank %}
            {% for product in block.settings.product_list %}
              <div class="ai-product-card-{{ ai_gen_id }}">
                <div class="ai-product-card-image-wrapper-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      class="ai-product-card-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="600"
                      height="750"
                    >
                  {% else %}
                    <div class="ai-product-card-image-{{ ai_gen_id }}">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}

                  {% if product.tags contains 'best-seller' or product.tags contains 'bestseller' %}
                    <span class="ai-product-card-badge-{{ ai_gen_id }}">Best Seller</span>
                  {% elsif product.tags contains 'new-colors' %}
                    <span class="ai-product-card-badge-{{ ai_gen_id }}">New Colors</span>
                  {% elsif product.tags contains 'new-arrival' or product.tags contains 'new' %}
                    <span class="ai-product-card-badge-{{ ai_gen_id }}">New Arrival</span>
                  {% endif %}
                </div>

                <div class="ai-product-card-content-{{ ai_gen_id }}">
                  <h3 class="ai-product-card-title-{{ ai_gen_id }}">
                    <a href="{{ product.url }}" class="ai-product-card-title-link-{{ ai_gen_id }}">
                      {{ product.title }}
                    </a>
                  </h3>

                  <div class="ai-product-card-price-{{ ai_gen_id }}">
                    {% if product.compare_at_price > product.price %}
                      <span class="ai-product-card-price-regular-{{ ai_gen_id }} ai-product-card-price-sale-{{ ai_gen_id }}">
                        {{ product.price | money }}
                      </span>
                      <span class="ai-product-card-price-compare-{{ ai_gen_id }}">
                        {{ product.compare_at_price | money }}
                      </span>
                    {% else %}
                      <span class="ai-product-card-price-regular-{{ ai_gen_id }}">
                        {{ product.price | money }}
                      </span>
                    {% endif %}
                  </div>

                  {% if block.settings.show_color_swatches %}
                    {% assign color_option = null %}
                    {% for option in product.options_with_values %}
                      {% assign option_name_downcase = option.name | downcase %}
                      {% if option_name_downcase == 'color' or option_name_downcase == 'colour' %}
                        {% assign color_option = option %}
                        {% break %}
                      {% endif %}
                    {% endfor %}

                    {% if color_option and color_option.values.size > 0 %}
                      <div class="ai-product-card-swatches-{{ ai_gen_id }}">
                        {% for value in color_option.values limit: block.settings.max_swatches %}
                          {% assign color_value = value | downcase | replace: ' ', '-' %}
                          <span
                            class="ai-product-card-swatch-{{ ai_gen_id }}"
                            style="background-color: {{ value | handle }};"
                            title="{{ value }}"
                          ></span>
                        {% endfor %}
                      </div>
                    {% endif %}
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          {% else %}
            {% for i in (1..8) %}
              <div class="ai-product-card-{{ ai_gen_id }}">
                <div class="ai-product-card-image-wrapper-{{ ai_gen_id }}">
                  <div class="ai-product-card-image-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                  {% if i == 1 %}
                    <span class="ai-product-card-badge-{{ ai_gen_id }}">Best Seller</span>
                  {% elsif i == 2 %}
                    <span class="ai-product-card-badge-{{ ai_gen_id }}">New Colors</span>
                  {% elsif i == 3 %}
                    <span class="ai-product-card-badge-{{ ai_gen_id }}">New Arrival</span>
                  {% endif %}
                </div>
                <div class="ai-product-card-content-{{ ai_gen_id }}">
                  <h3 class="ai-product-card-title-{{ ai_gen_id }}">
                    <a href="#" class="ai-product-card-title-link-{{ ai_gen_id }}">
                      Product Title {{ i }}
                    </a>
                  </h3>
                  <div class="ai-product-card-price-{{ ai_gen_id }}">
                    <span class="ai-product-card-price-regular-{{ ai_gen_id }}">$29.99</span>
                  </div>
                  {% if block.settings.show_color_swatches %}
                    <div class="ai-product-card-swatches-{{ ai_gen_id }}">
                      <span class="ai-product-card-swatch-{{ ai_gen_id }}" style="background-color: #000000;"></span>
                      <span class="ai-product-card-swatch-{{ ai_gen_id }}" style="background-color: #ffffff; border-color: #ddd;"></span>
                      <span class="ai-product-card-swatch-{{ ai_gen_id }}" style="background-color: #0066cc;"></span>
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          {% endif %}
        </div>
      </div>

      <button
        class="ai-carousel-nav-{{ ai_gen_id }} ai-carousel-nav-next-{{ ai_gen_id }}"
        aria-label="Next products"
        data-nav="next"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    {% if block.settings.show_progress_bar %}
      <div class="ai-carousel-progress-wrapper-{{ ai_gen_id }}">
        <div class="ai-carousel-progress-bar-{{ ai_gen_id }}">
          <div class="ai-carousel-progress-fill-{{ ai_gen_id }}" data-progress></div>
        </div>
      </div>
    {% endif %}
  </div>
</product-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('[data-track]');
        this.prevButton = this.querySelector('[data-nav="prev"]');
        this.nextButton = this.querySelector('[data-nav="next"]');
        this.progressFill = this.querySelector('[data-progress]');
      }

      connectedCallback() {
        this.setupEventListeners();
        this.updateProgress();
        this.updateNavButtons();
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.scroll('prev'));
        this.nextButton.addEventListener('click', () => this.scroll('next'));
        
        this.track.addEventListener('scroll', () => {
          this.updateProgress();
          this.updateNavButtons();
        });

        let resizeTimer;
        window.addEventListener('resize', () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => {
            this.updateProgress();
            this.updateNavButtons();
          }, 250);
        });
      }

      scroll(direction) {
        const cardWidth = this.track.querySelector('.ai-product-card-{{ ai_gen_id }}').offsetWidth;
        const gap = parseInt(getComputedStyle(this.track).gap) || 0;
        const scrollAmount = cardWidth + gap;

        if (direction === 'prev') {
          this.track.scrollLeft -= scrollAmount;
        } else {
          this.track.scrollLeft += scrollAmount;
        }
      }

      updateProgress() {
        if (!this.progressFill) return;

        const scrollWidth = this.track.scrollWidth - this.track.clientWidth;
        const scrollLeft = this.track.scrollLeft;
        const progress = scrollWidth > 0 ? (scrollLeft / scrollWidth) * 100 : 0;
        
        this.progressFill.style.width = progress + '%';
      }

      updateNavButtons() {
        const isAtStart = this.track.scrollLeft <= 0;
        const isAtEnd = this.track.scrollLeft >= this.track.scrollWidth - this.track.clientWidth - 1;

        this.prevButton.disabled = isAtStart;
        this.nextButton.disabled = isAtEnd;
      }
    }

    customElements.define('product-carousel-{{ ai_gen_id }}', ProductCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product carousel",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "section_title",
