{% doc %}
  @prompt
    Create a responsive product grid section with separate controls for mobile and desktop layouts. Include settings to adjust how many products appear per row on mobile (1-3 products) and desktop (2-6 products). The grid should automatically adapt between the two layouts and include product images, titles, prices, and add to cart buttons. Make the entire product card a clickable link that navigates to the product page when tapped or clicked. Make it visually appealing with proper spacing and hover effects that indicate the card is interactive., make the buttons and product image a clickable object to go to the product page, give more image ratio options

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-grid-{{ ai_gen_id }} {
    margin:0 auto;
    padding: {{ block.settings.grid_padding }}px;}

  .ai-product-grid__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-product-grid__title-{{ ai_gen_id }} {
    margin: 0 0 10px;
    font-size: 24px;
    font-weight: 600;
    color: {{ block.settings.heading_color }};
  }

  .ai-product-grid__description-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  .ai-product-grid__products-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-product-card-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: {{ block.settings.card_background_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
  }

  .ai-product-card__image-container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  {% if block.settings.image_ratio == 'square' %}
    .ai-product-card__image-container-{{ ai_gen_id }} {
      padding-bottom: 100%;
    }
  {% elsif block.settings.image_ratio == 'portrait' %}
    .ai-product-card__image-container-{{ ai_gen_id }} {
      padding-bottom: 125%;
    }
  {% elsif block.settings.image_ratio == 'landscape' %}
    .ai-product-card__image-container-{{ ai_gen_id }} {
      padding-bottom: 75%;
    }
  {% elsif block.settings.image_ratio == 'wide' %}
    .ai-product-card__image-container-{{ ai_gen_id }} {
      padding-bottom: 56.25%;
    }
  {% elsif block.settings.image_ratio == 'tall' %}
    .ai-product-card__image-container-{{ ai_gen_id }} {
      padding-bottom: 150%;
    }
  {% endif %}

  .ai-product-card__image-link-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .ai-product-card__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
    transition: transform 0.5s ease;
  }

  .ai-product-card-{{ ai_gen_id }}:hover .ai-product-card__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-product-card__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;}

  .ai-product-card__placeholder-{{ ai_gen_id }} svg {
    width: 80%;
    height: 80%;
  }

  .ai-product-card__info-{{ ai_gen_id }} {
    padding: 15px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-product-card__title-{{ ai_gen_id }} {
    margin: 0 0 5px;
    font-size: 16px;
    font-weight: 500;
    color: {{ block.settings.title_color }};
  }

  .ai-product-card__vendor-{{ ai_gen_id }} {
    margin: 0 0 10px;
    font-size: 14px;
    color: {{ block.settings.vendor_color }};
    opacity: 0.8;
  }

  .ai-product-card__price-{{ ai_gen_id }} {
    margin: 0 0 15px;
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.price_color }};
  }

  .ai-product-card__price-compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.7;
    margin-right: 8px;
  }

  .ai-product-card__price-sale-{{ ai_gen_id }} {
    color: {{ block.settings.sale_color }};
  }

  .ai-product-card__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 10px 20px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 14px;
    font-weight: 500;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.3s ease;margin-top: auto;
  }

  .ai-product-card__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    color: {{ block.settings.button_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-product-grid__products-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }
    .ai-product-grid__title-{{ ai_gen_id }} {
      font-size: 20px;
    }
    
    .ai-product-card__info-{{ ai_gen_id }} {
      padding: 12px;
    }
    .ai-product-card__title-{{ ai_gen_id }} {
      font-size: 14px;
    }
    
    .ai-product-card__price-{{ ai_gen_id }} {
      font-size: 14px;
    }
    
    .ai-product-card__button-{{ ai_gen_id }} {
      padding: 8px 16px;
      font-size: 12px;
    }
  }
{% endstyle %}

<div class="ai-product-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank or block.settings.description != blank %}
    <div class="ai-product-grid__header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-product-grid__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      
      {% if block.settings.description != blank %}
        <div class="ai-product-grid__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
    </div>
  {% endif %}
  <div class="ai-product-grid__products-{{ ai_gen_id }}">
    {% if block.settings.collection != blank %}
      {% assign product_limit = block.settings.products_to_show %}
      {% for product in block.settings.collection.products limit: product_limit %}
        <div class="ai-product-card-{{ ai_gen_id }}">
          <div class="ai-product-card__image-container-{{ ai_gen_id }}">
            <a href="{{ product.url }}" class="ai-product-card__image-link-{{ ai_gen_id }}">
              {% if product.featured_image != blank %}
                <img 
                  src="{{ product.featured_image | image_url: width: 500}}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                  class="ai-product-card__image-{{ ai_gen_id }}"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                >
              {% else %}
                <div class="ai-product-card__placeholder-{{ ai_gen_id }}">
                  {{ 'product-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </a>
          </div><div class="ai-product-card__info-{{ ai_gen_id }}">
            {% if block.settings.show_vendor and product.vendor != blank %}
              <p class="ai-product-card__vendor-{{ ai_gen_id }}">{{ product.vendor }}</p>
            {% endif %}<h3 class="ai-product-card__title-{{ ai_gen_id }}">{{ product.title }}</h3>
            <div class="ai-product-card__price-{{ ai_gen_id }}">
              {% if product.compare_at_price > product.price %}
                <span class="ai-product-card__price-compare-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
                <span class="ai-product-card__price-sale-{{ ai_gen_id }}">{{ product.price | money }}</span>
              {% else %}
                {{ product.price | money }}
              {% endif %}
            </div>
            
            <a 
              href="{{ product.url }}"
              class="ai-product-card__button-{{ ai_gen_id }}"
            >
              {{ block.settings.button_label }}
            </a>
          </div>
        </div>
      {% endfor %}
    {% else %}
      {% for i in (1..block.settings.products_to_show) %}
        <div class="ai-product-card-{{ ai_gen_id }}">
          <div class="ai-product-card__image-container-{{ ai_gen_id }}">
            <div class="ai-product-card__image-link-{{ ai_gen_id }}"><div class="ai-product-card__placeholder-{{ ai_gen_id }}">
                {{ 'product-apparel-1' | placeholder_svg_tag }}
              </div>
            </div>
          </div>
          <div class="ai-product-card__info-{{ ai_gen_id }}">
            {% if block.settings.show_vendor %}
              <p class="ai-product-card__vendor-{{ ai_gen_id }}">Sample vendor</p>
            {% endif %}
            
            <h3 class="ai-product-card__title-{{ ai_gen_id }}">Product title</h3>
            
            <div class="ai-product-card__price-{{ ai_gen_id }}">
              $29.99
            </div>
            
            <div class="ai-product-card__button-{{ ai_gen_id }}">
              {{ block.settings.button_label }}
            </div>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Product Grid",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Heading bottom spacing",
      "default": 30
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8,
      "label": "Maximum products to show"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show product vendor",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View Product"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Products per row (desktop)"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Products per row (mobile)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Grid gap",
      "default": 20
    },
    {
      "type": "range",
      "id": "grid_padding",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Grid padding",
      "default": 20
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "portrait",
          "label": "Portrait (4:5)"
        },
        {
          "value": "landscape",
          "label": "Landscape (4:3)"
        },
        {
          "value": "wide",
          "label": "Wide (16:9)"
        },
        {
          "value": "tall",
          "label": "Tall (2:3)"
        }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ],
      "default": "cover"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#141414"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#737373"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Product title color",
      "default": "#141414"
    },
    {
      "type": "color",
      "id": "vendor_color",
      "label": "Vendor color",
      "default": "#737373"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#141414"
    },
    {
      "type": "color",
      "id": "sale_color",
      "label": "Sale price color",
      "default": "#E31B1B"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background color",
      "default": "#141414"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover background color",
      "default": "#3f3f3f"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Card border radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Button border radius",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Product Grid"
    }
  ]
}
{% endschema %}