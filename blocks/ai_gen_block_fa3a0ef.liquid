{% doc %}
  @prompt
    Create a custom auto-sliding banner section that cycles through 3 promotional images to highlight free items included with orders. The section should have a clean, modern design with smooth transitions between slides, customizable timing controls, and settings for images, text overlays, and styling options. Include options to customize slide duration, transition effects, background colors, text positioning, and mobile responsiveness. The design should be professional and fit well with jewelry/accessories themes., make the images fit the image
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-promo-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-promo-banner-slider-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.banner_height }}px;
  }

  .ai-promo-banner-slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity {{ block.settings.transition_duration }}ms ease-in-out;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-promo-banner-slide-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-promo-banner-slide-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
    object-position: {{ block.settings.image_position }};
    z-index: 1;
  }

  .ai-promo-banner-slide-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .ai-promo-banner-slide-placeholder-{{ ai_gen_id }} svg {
    width: 100px;
    height: 100px;
    opacity: 0.3;
  }

  .ai-promo-banner-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }

  .ai-promo-banner-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    text-align: {{ block.settings.text_alignment }};
    padding: 40px 20px;
    max-width: 800px;
    width: 100%;
  }

  .ai-promo-banner-title-{{ ai_gen_id }} {
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    font-weight: {{ settings.type_header_font.weight }};
    font-style: {{ settings.type_header_font.style }};
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.2;
    margin: 0 0 16px;
    text-transform: {{ settings.font_header_text_transform }};
    letter-spacing: {{ settings.type_header_letter_spacing }}px;
  }

  .ai-promo-banner-subtitle-{{ ai_gen_id }} {
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-weight: {{ settings.type_body_font.weight }};
    font-style: {{ settings.type_body_font.style }};
    color: {{ block.settings.subtitle_color }};
    font-size: {{ block.settings.subtitle_size }}px;
    line-height: 1.4;
    margin: 0 0 24px;
  }

  .ai-promo-banner-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ settings.button_border_radius }}px;
    font-family: {{ settings.type_button_font.family }}, {{ settings.type_button_font.fallback_families }};
    font-weight: {{ settings.type_button_font.weight }};
    font-style: {{ settings.type_button_font.style }};
    text-transform: {{ settings.button_text_transform }};
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-promo-banner-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
  }

  .ai-promo-banner-controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 4;
  }

  .ai-promo-banner-dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    transition: all 0.3s ease;
    border: none;
    padding: 0;
  }

  .ai-promo-banner-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
    transform: scale(1.2);
  }

  .ai-promo-banner-pause-btn-{{ ai_gen_id }} {
    position: absolute;
    top: 20px;
    right: 20px;
    background: rgba(0, 0, 0, 0.5);
    color: white;
    border: none;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 4;
    transition: all 0.3s ease;
  }

  .ai-promo-banner-pause-btn-{{ ai_gen_id }}:hover {
    background: rgba(0, 0, 0, 0.7);
  }

  .ai-promo-banner-pause-btn-{{ ai_gen_id }} svg {
    width: 16px;
    height: 16px;
  }

  @media screen and (max-width: 749px) {
    .ai-promo-banner-slider-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_height }}px;
    }

    .ai-promo-banner-content-{{ ai_gen_id }} {
      padding: 20px 16px;
    }

    .ai-promo-banner-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-promo-banner-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-promo-banner-controls-{{ ai_gen_id }} {
      bottom: 16px;
    }

    .ai-promo-banner-pause-btn-{{ ai_gen_id }} {
      top: 16px;
      right: 16px;
      width: 36px;
      height: 36px;
    }
  }
{% endstyle %}

<promo-banner-{{ ai_gen_id }}
  class="ai-promo-banner-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-slide-duration="{{ block.settings.slide_duration }}"
  data-transition-duration="{{ block.settings.transition_duration }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-promo-banner-slider-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
        assign image_key = 'slide_' | append: i | append: '_image'
        assign title_key = 'slide_' | append: i | append: '_title'
        assign subtitle_key = 'slide_' | append: i | append: '_subtitle'
        assign button_text_key = 'slide_' | append: i | append: '_button_text'
        assign button_link_key = 'slide_' | append: i | append: '_button_link'

        assign slide_enabled = block.settings[slide_enabled_key]
        assign image = block.settings[image_key]
        assign title = block.settings[title_key]
        assign subtitle = block.settings[subtitle_key]
        assign button_text = block.settings[button_text_key]
        assign button_link = block.settings[button_link_key]
      %}

      {% if slide_enabled %}
        <div
          class="ai-promo-banner-slide-{{ ai_gen_id }}{% if forloop.first %} active{% endif %}"
          data-slide="{{ forloop.index0 }}"
        >
          {% if image %}
            <img
              src="{{ image | image_url: width: 1920 }}"
              alt="{{ image.alt | escape }}"
              class="ai-promo-banner-slide-image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
            >
          {% else %}
            <div class="ai-promo-banner-slide-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}

          {% if block.settings.show_overlay %}
            <div class="ai-promo-banner-overlay-{{ ai_gen_id }}"></div>
          {% endif %}

          <div class="ai-promo-banner-content-{{ ai_gen_id }}">
            {% if title != blank %}
              <h2 class="ai-promo-banner-title-{{ ai_gen_id }}">{{ title }}</h2>
            {% endif %}

            {% if subtitle != blank %}
              <p class="ai-promo-banner-subtitle-{{ ai_gen_id }}">{{ subtitle }}</p>
            {% endif %}

            {% if button_text != blank and button_link != blank %}
              <a
                href="{{ button_link }}"
                class="ai-promo-banner-button-{{ ai_gen_id }}"
              >
                {{ button_text }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {% if block.settings.show_controls %}
    <div class="ai-promo-banner-controls-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
          assign slide_enabled = block.settings[slide_enabled_key]
        %}
        {% if slide_enabled %}
          <button
            class="ai-promo-banner-dot-{{ ai_gen_id }}{% if forloop.first %} active{% endif %}"
            data-slide="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

  {% if block.settings.show_pause_button %}
    <button
      class="ai-promo-banner-pause-btn-{{ ai_gen_id }}"
      aria-label="Pause slideshow"
      data-action="pause"
    >
      <svg class="play-icon" style="display: none;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
        <path d="M8 5v14l11-7z"/>
      </svg>
      <svg class="pause-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
        <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
      </svg>
    </button>
  {% endif %}
</promo-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class PromoBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.isPlaying = true;
        this.slideInterval = null;
      }

      connectedCallback() {
        this.slides = this.querySelectorAll('.ai-promo-banner-slide-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-promo-banner-dot-{{ ai_gen_id }}');
        this.pauseBtn = this.querySelector('.ai-promo-banner-pause-btn-{{ ai_gen_id }}');
        
        this.autoplay = this.dataset.autoplay === 'true';
        this.slideDuration = parseInt(this.dataset.slideDuration) || 5000;
        this.transitionDuration = parseInt(this.dataset.transitionDuration) || 500;

        this.enabledSlides = Array.from(this.slides).filter(slide => 
          slide.style.display !== 'none'
        );

        if (this.enabledSlides.length <= 1) {
          this.autoplay = false;
          if (this.pauseBtn) this.pauseBtn.style.display = 'none';
        }

        this.setupEventListeners();
        
        if (this.autoplay && this.enabledSlides.length > 1) {
          this.startSlideshow();
        }
      }

      setupEventListeners() {
        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => {
            this.goToSlide(index);
            if (this.autoplay) {
              this.restartSlideshow();
            }
          });
        });

        if (this.pauseBtn) {
          this.pauseBtn.addEventListener('click', () => {
            this.togglePlayPause();
          });
        }

        this.addEventListener('mouseenter', () => {
          if (this.autoplay) {
            this.pauseSlideshow();
          }
        });

        this.addEventListener('mouseleave', () => {
          if (this.autoplay && this.isPlaying) {
            this.startSlideshow();
          }
        });
      }

      goToSlide(index) {
        this.slides[this.currentSlide].classList.remove('active');
        if (this.dots[this.currentSlide]) {
          this.dots[this.currentSlide].classList.remove('active');
        }

        this.currentSlide = index;

        this.slides[this.currentSlide].classList.add('active');
        if (this.dots[this.currentSlide]) {
          this.dots[this.currentSlide].classList.add('active');
        }
      }

      nextSlide() {
        const nextIndex = (this.currentSlide + 1) % this.enabledSlides.length;
        this.goToSlide(nextIndex);
      }

      startSlideshow() {
        if (this.slideInterval) {
          clearInterval(this.slideInterval);
        }
        
        this.slideInterval = setInterval(() => {
          this.nextSlide();
        }, this.slideDuration);
      }

      pauseSlideshow() {
        if (this.slideInterval) {
          clearInterval(this.slideInterval);
          this.slideInterval = null;
        }
      }

      restartSlideshow() {
        this.pauseSlideshow();
        this.startSlideshow();
      }

      togglePlayPause() {
        this.isPlaying = !this.isPlaying;
        
        const playIcon = this.pauseBtn.querySelector('.play-icon');
        const pauseIcon = this.pauseBtn.querySelector('.pause-icon');
        
        if (this.isPlaying) {
          this.startSlideshow();
          playIcon.style.display = 'none';
          pauseIcon.style.display = 'block';
          this.pauseBtn.setAttribute('aria-label', 'Pause slideshow');
        } else {
          this.pauseSlideshow();
          playIcon.style.display = 'block';
          pauseIcon.style.display = 'none';
          this.pauseBtn.setAttribute('aria-label', 'Play slideshow');
        }
      }

      disconnectedCallback() {
        if (this.slideInterval) {
          clearInterval(this.slideInterval);
        }
      }
    }

    customElements.define('promo-banner-{{ ai_gen_id }}', PromoBanner{{ ai_gen_id }});
  })();
</script>

