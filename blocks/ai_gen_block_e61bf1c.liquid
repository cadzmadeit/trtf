            {% endif %}
            <h3 class="ai-accordion-title-{{ ai_gen_id }}">{{ item_heading }}</h3>
          </div>
          <div class="ai-accordion-toggle-{{ ai_gen_id }}">
            <span class="ai-accordion-toggle-icon-{{ ai_gen_id }} ai-accordion-toggle-plus-{{ ai_gen_id }}">
