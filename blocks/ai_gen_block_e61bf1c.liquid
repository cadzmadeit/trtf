        </button>
        <div class="ai-accordion-content-{{ ai_gen_id }}" data-accordion-content>
          <div class="ai-accordion-content-inner-{{ ai_gen_id }}">
            {% if item_content != blank %}
              <div class="ai-accordion-text-{{ ai_gen_id }}">
                {{ item_content }}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endif %}
  {% endfor %}
</product-accordion-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductAccordion{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.items = [];
      }

      connectedCallback() {
        this.initAccordion();
      }

      initAccordion() {
        const accordionItems = this.querySelectorAll('[data-accordion-item]');
        
        accordionItems.forEach((item) => {
          const trigger = item.querySelector('[data-accordion-trigger]');
          const content = item.querySelector('[data-accordion-content]');
          
          if (trigger && content) {
            this.items.push({ item, trigger, content });
            
            trigger.addEventListener('click', () => {
              this.toggleItem(item, trigger, content);
            });
          }
        });
      }

      toggleItem(item, trigger, content) {
        const isActive = item.classList.contains('active');
        
        if (isActive) {
          this.closeItem(item, trigger, content);
        } else {
          this.openItem(item, trigger, content);
        }
      }

      openItem(item, trigger, content) {
        item.classList.add('active');
        trigger.setAttribute('aria-expanded', 'true');
        
        const contentInner = content.querySelector('.ai-accordion-content-inner-{{ ai_gen_id }}');
        const height = contentInner.scrollHeight;
        content.style.maxHeight = height + 'px';
      }

      closeItem(item, trigger, content) {
        item.classList.remove('active');
        trigger.setAttribute('aria-expanded', 'false');
        content.style.maxHeight = '0';
      }
    }

    customElements.define('product-accordion-{{ ai_gen_id }}', ProductAccordion{{ ai_gen_id }});
  })();
</script>

