{% doc %}
  @prompt
    Create a customizable collapsible accordion section for product pages with expandable dropdown menus. Include settings to add multiple accordion items, each with a custom heading, icon, and rich text content. Add icon options for common product page sections like shipping info, returns policy, FAQ, size guide, care instructions, and materials. Style with clean typography, smooth expand/collapse animations, plus/minus toggle icons, and ensure it's fully responsive for mobile and desktop. Make all text, icons, and number of accordion items easily customizable through the theme editor settings., make the icons and text a bit to the right so its not so close to the border, add a section called description. make the icons and text the same amount more to the right. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-accordion-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
  }

  .ai-accordion-item-{{ ai_gen_id }} {
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-accordion-item-{{ ai_gen_id }}:first-child {
    border-top: 1px solid {{ block.settings.border_color }};
  }

  .ai-accordion-header-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: {{ block.settings.item_padding }}px {{ block.settings.horizontal_padding }}px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    gap: 16px;
    transition: opacity 0.2s ease;
  }

  .ai-accordion-header-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-accordion-header-left-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 0;
  }

  .ai-accordion-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
  }

  .ai-accordion-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke-width: 1.5;
  }

  .ai-accordion-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    margin: 0;
    line-height: 1.4;
  }

  .ai-accordion-toggle-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.toggle_size }}px;
    height: {{ block.settings.toggle_size }}px;
    position: relative;
    color: {{ block.settings.toggle_color }};
  }

  .ai-accordion-toggle-icon-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .ai-accordion-toggle-icon-{{ ai_gen_id }} svg {
    width: {{ block.settings.toggle_size }}px;
    height: {{ block.settings.toggle_size }}px;
    stroke-width: 2;
  }

  .ai-accordion-toggle-plus-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-accordion-toggle-minus-{{ ai_gen_id }} {
    opacity: 0;
  }

  .ai-accordion-item-{{ ai_gen_id }}.active .ai-accordion-toggle-plus-{{ ai_gen_id }} {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .ai-accordion-item-{{ ai_gen_id }}.active .ai-accordion-toggle-minus-{{ ai_gen_id }} {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .ai-accordion-content-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease;
  }

  .ai-accordion-content-inner-{{ ai_gen_id }} {
    padding: 0 {{ block.settings.horizontal_padding }}px {{ block.settings.item_padding }}px {{ block.settings.horizontal_padding }}px;
    {% if block.settings.indent_content %}
      padding-left: calc({{ block.settings.horizontal_padding }}px + {{ block.settings.icon_size }}px + 12px);
    {% endif %}
  }

  .ai-accordion-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.content_size }}px;
    line-height: 1.6;
    color: {{ block.settings.content_color }};
  }

  .ai-accordion-text-{{ ai_gen_id }} p {
    margin: 0 0 12px 0;
  }

  .ai-accordion-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-accordion-text-{{ ai_gen_id }} ul,
  .ai-accordion-text-{{ ai_gen_id }} ol {
    margin: 0 0 12px 0;
    padding-left: 20px;
  }

  .ai-accordion-text-{{ ai_gen_id }} li {
    margin-bottom: 8px;
  }

  @media screen and (max-width: 749px) {
    .ai-accordion-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.9);
    }

    .ai-accordion-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.content_size }}px * 0.95);
    }

    .ai-accordion-icon-{{ ai_gen_id }} {
      width: calc({{ block.settings.icon_size }}px * 0.9);
      height: calc({{ block.settings.icon_size }}px * 0.9);
    }

    .ai-accordion-header-{{ ai_gen_id }} {
      padding-left: {{ block.settings.horizontal_padding | times: 0.75 }}px;
      padding-right: {{ block.settings.horizontal_padding | times: 0.75 }}px;
    }

    .ai-accordion-content-inner-{{ ai_gen_id }} {
      padding-left: {{ block.settings.horizontal_padding | times: 0.75 }}px;
      padding-right: {{ block.settings.horizontal_padding | times: 0.75 }}px;
      {% if block.settings.indent_content %}
        padding-left: calc({{ block.settings.horizontal_padding | times: 0.75 }}px + {{ block.settings.icon_size | times: 0.9 }}px + 12px);
      {% endif %}
    }
  }
{% endstyle %}

<product-accordion-{{ ai_gen_id }} class="ai-accordion-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% for i in (1..10) %}
    {% liquid
      assign item_enabled_key = 'item_' | append: i | append: '_enabled'
      assign item_heading_key = 'item_' | append: i | append: '_heading'
      assign item_icon_key = 'item_' | append: i | append: '_icon'
      assign item_content_key = 'item_' | append: i | append: '_content'

      assign item_enabled = block.settings[item_enabled_key]
      assign item_heading = block.settings[item_heading_key]
      assign item_icon = block.settings[item_icon_key]
      assign item_content = block.settings[item_content_key]
    %}

    {% if item_enabled and item_heading != blank %}
      <div class="ai-accordion-item-{{ ai_gen_id }}" data-accordion-item>
        <button
          class="ai-accordion-header-{{ ai_gen_id }}"
          aria-expanded="false"
          data-accordion-trigger
        >
          <div class="ai-accordion-header-left-{{ ai_gen_id }}">
            {% if item_icon != 'none' %}
              <div class="ai-accordion-icon-{{ ai_gen_id }}">
                {% case item_icon %}
                  {% when 'shipping' %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
                    </svg>
                  {% when 'returns' %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" />
                    </svg>
                  {% when 'faq' %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" />
                    </svg>
                  {% when 'size' %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
                    </svg>
                  {% when 'care' %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                    </svg>
                  {% when 'materials' %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z" />
