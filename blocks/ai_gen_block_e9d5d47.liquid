{% doc %}
  @prompt
    Create a "You May Also Like" product recommendation section for a Shopify product page.
    
    Layout:
    - Section title "YOU MAY ALSO LIKE" in bold, uppercase, left-aligned, blackletter/gothic-style font if theme font supports it, otherwise bold sans-serif
    - 2-column grid on mobile, 4-column on desktop
    - Each product card shows: product image (square, light gray background), product title in bold uppercase, price below title
    - Small pagination dots under each image if the product has multiple images (swipeable)
    - Use Shopify's product recommendations API (recommendations.json) to pull related/complementary products based on the current product
    - Fallback to best-selling products if no recommendations are returned
    - Cards should be clickable, linking to each product's page
    - Consistent spacing/padding matching the rest of the theme (Noord Essentials style)
    - Background: white/light gray, black text, minimal gothic aesthetic — no rounded card borders, sharp edges
    - Add subtle hover effect (slight opacity change or scale) on desktop
    - Make it a theme section with schema settings for: section heading text, number of products to show (default 4), and enable/disable "show only same collection" toggle
    
    everything should be highly customizable and optimized, i should be able to update the grid layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-recommendations-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-recommendations-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.container_padding }}px;
  }

  .ai-recommendations-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    text-transform: uppercase;
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    text-align: {{ block.settings.heading_alignment }};
  }

  .ai-recommendations-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    gap: {{ block.settings.grid_gap_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .ai-recommendations-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
      gap: {{ block.settings.grid_gap_desktop }}px;
    }
  }

  .ai-product-card-{{ ai_gen_id }} {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
    transition: opacity {{ block.settings.hover_transition_speed }}s ease, transform {{ block.settings.hover_transition_speed }}s ease;
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    opacity: {{ block.settings.hover_opacity }};
  }

  @media screen and (min-width: 750px) {
    .ai-product-card-{{ ai_gen_id }}:hover {
      {% if block.settings.hover_scale_enabled %}
        transform: scale(1.05);
      {% endif %}
    }
  }

  .ai-product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: {{ block.settings.image_background_color }};
    overflow: hidden;
    margin-bottom: {{ block.settings.image_margin_bottom }}px;
  }

  .ai-product-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
    display: block;
  }

  .ai-product-pagination-{{ ai_gen_id }} {
    position: absolute;
    bottom: {{ block.settings.pagination_bottom_spacing }}px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: {{ block.settings.pagination_dot_spacing }}px;
    z-index: 2;
  }

  .ai-pagination-dot-{{ ai_gen_id }} {
    width: {{ block.settings.pagination_dot_size }}px;
    height: {{ block.settings.pagination_dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.pagination_dot_color }};
    opacity: {{ block.settings.pagination_dot_opacity }};
    transition: opacity 0.3s ease;
  }

  .ai-pagination-dot-{{ ai_gen_id }}.active {
    opacity: 1;
    background-color: {{ block.settings.pagination_dot_active_color }};
  }

  .ai-product-info-{{ ai_gen_id }} {
    text-align: {{ block.settings.product_info_alignment }};
  }

  .ai-product-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.product_title_font.family }}, {{ block.settings.product_title_font.fallback_families }};
    font-weight: {{ block.settings.product_title_font.weight }};
    font-style: {{ block.settings.product_title_font.style }};
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    text-transform: uppercase;
    letter-spacing: {{ block.settings.product_title_letter_spacing }}px;
    margin: 0 0 {{ block.settings.product_title_margin_bottom }}px;
    line-height: {{ block.settings.product_title_line_height }};
  }

  .ai-product-price-{{ ai_gen_id }} {
    font-family: {{ block.settings.product_price_font.family }}, {{ block.settings.product_price_font.fallback_families }};
    font-weight: {{ block.settings.product_price_font.weight }};
    font-style: {{ block.settings.product_price_font.style }};
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
    letter-spacing: {{ block.settings.product_price_letter_spacing }}px;
  }

  .ai-no-recommendations-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: {{ block.settings.heading_color }};
    font-size: 14px;
  }
{% endstyle %}

<product-recommendations-{{ ai_gen_id }}
  class="ai-recommendations-{{ ai_gen_id }}"
  data-product-id="{{ product.id }}"
  data-limit="{{ block.settings.products_to_show }}"
  data-same-collection="{{ block.settings.same_collection_only }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-recommendations-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-recommendations-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-recommendations-grid-{{ ai_gen_id }}" data-recommendations-grid></div>

    <div class="ai-no-recommendations-{{ ai_gen_id }}" data-no-recommendations style="display: none;">
      {{ block.settings.no_recommendations_text }}
    </div>
  </div>
</product-recommendations-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductRecommendations{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.productId = this.dataset.productId;
        this.limit = parseInt(this.dataset.limit) || 4;
        this.sameCollectionOnly = this.dataset.sameCollection === 'true';
        this.grid = this.querySelector('[data-recommendations-grid]');
        this.noRecommendationsMessage = this.querySelector('[data-no-recommendations]');
        this.currentImageIndexes = {};
      }

      connectedCallback() {
        this.fetchRecommendations();
      }

      async fetchRecommendations() {
        try {
          const url = `/recommendations/products.json?product_id=${this.productId}&limit=${this.limit}`;
          const response = await fetch(url);
          const data = await response.json();

          if (data.products && data.products.length > 0) {
            let products = data.products;

            if (this.sameCollectionOnly && window.currentProductCollections) {
              products = products.filter(product => {
                return product.collections && product.collections.some(collection =>
                  window.currentProductCollections.includes(collection.handle)
                );
              });
            }

            if (products.length > 0) {
              this.renderProducts(products);
            } else {
              this.showNoRecommendations();
            }
          } else {
            this.showNoRecommendations();
          }
        } catch (error) {
          console.error('Error fetching recommendations:', error);
          this.showNoRecommendations();
        }
      }

      renderProducts(products) {
        this.grid.innerHTML = products.map((product, index) => {
          this.currentImageIndexes[index] = 0;
          const hasMultipleImages = product.images && product.images.length > 1;
          const showPagination = hasMultipleImages && {{ block.settings.show_pagination | json }};

          return `
            <a href="${product.url}" class="ai-product-card-{{ ai_gen_id }}" data-product-index="${index}">
              <div class="ai-product-image-wrapper-{{ ai_gen_id }}">
                <img
                  src="${product.featured_image}"
                  alt="${this.escapeHtml(product.title)}"
                  class="ai-product-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600"
                  data-product-image
                >
                ${showPagination ? `
                  <div class="ai-product-pagination-{{ ai_gen_id }}">
                    ${product.images.map((img, imgIndex) => `
                      <span class="ai-pagination-dot-{{ ai_gen_id }} ${imgIndex === 0 ? 'active' : ''}" data-dot-index="${imgIndex}"></span>
                    `).join('')}
                  </div>
                ` : ''}
              </div>
              <div class="ai-product-info-{{ ai_gen_id }}">
                <h3 class="ai-product-title-{{ ai_gen_id }}">${this.escapeHtml(product.title)}</h3>
                <div class="ai-product-price-{{ ai_gen_id }}">${this.formatMoney(product.price)}</div>
              </div>
            </a>
          `;
        }).join('');

        this.storeProductData(products);
        this.setupImageSwipe();
      }

      storeProductData(products) {
        this.productsData = products;
      }

      setupImageSwipe() {
        const cards = this.querySelectorAll('.ai-product-card-{{ ai_gen_id }}');

        cards.forEach(card => {
          const productIndex = parseInt(card.dataset.productIndex);
          const product = this.productsData[productIndex];

          if (!product || !product.images || product.images.length <= 1) return;

          const imageWrapper = card.querySelector('.ai-product-image-wrapper-{{ ai_gen_id }}');
          const image = card.querySelector('[data-product-image]');
          const dots = card.querySelectorAll('.ai-pagination-dot-{{ ai_gen_id }}');

          let startX = 0;
          let isDragging = false;

          const handleStart = (e) => {
            isDragging = true;
            startX = e.type.includes('mouse') ? e.pageX : e.touches[0].pageX;
          };

          const handleEnd = (e) => {
            if (!isDragging) return;
            isDragging = false;

            const endX = e.type.includes('mouse') ? e.pageX : e.changedTouches[0].pageX;
            const diff = startX - endX;

            if (Math.abs(diff) > 50) {
              if (diff > 0) {
                this.nextImage(productIndex, product, image, dots);
              } else {
                this.prevImage(productIndex, product, image, dots);
              }
            }
          };

          imageWrapper.addEventListener('mousedown', handleStart);
          imageWrapper.addEventListener('touchstart', handleStart, { passive: true });
          imageWrapper.addEventListener('mouseup', handleEnd);
          imageWrapper.addEventListener('touchend', handleEnd);
          imageWrapper.addEventListener('mouseleave', () => { isDragging = false; });
        });
      }

      nextImage(productIndex, product, image, dots) {
        this.currentImageIndexes[productIndex] = (this.currentImageIndexes[productIndex] + 1) % product.images.length;
        this.updateImage(productIndex, product, image, dots);
      }

      prevImage(productIndex, product, image, dots) {
        this.currentImageIndexes[productIndex] = (this.currentImageIndexes[productIndex] - 1 + product.images.length) % product.images.length;
        this.updateImage(productIndex, product, image, dots);
      }

      updateImage(productIndex, product, image, dots) {
        const currentIndex = this.currentImageIndexes[productIndex];
        image.src = product.images[currentIndex];

        dots.forEach((dot, index) => {
          if (index === currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      showNoRecommendations() {
        this.grid.style.display = 'none';
        this.noRecommendationsMessage.style.display = 'block';
      }

      formatMoney(cents) {
        const amount = cents / 100;
        return new Intl.NumberFormat('en-US', {
          style: 'currency',
          currency: '{{ cart.currency.iso_code }}',
        }).format(amount);
      }

      escapeHtml(text) {
        const map = {
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#039;'
        };
        return text.replace(/[&<>"']/g, m => map[m]);
      }
    }

    customElements.define('product-recommendations-{{ ai_gen_id }}', ProductRecommendations{{ ai_gen_id }});
  })();
</script>

{% if product.collections %}
  <script>
    window.currentProductCollections = {{ product.collections | map: 'handle' | json }};
  </script>
{% endif %}

