<script>
  (function() {
    class ProductPage{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.mainImage = this.querySelector('[data-main-image] img');
        this.thumbnails = this.querySelectorAll('[data-thumbnail]');
        this.accordionItems = this.querySelectorAll('[data-accordion-item]');
        this.quantityInput = this.querySelector('[data-quantity-input]');
        this.quantityMinus = this.querySelector('[data-quantity-minus]');
        this.quantityPlus = this.querySelector('[data-quantity-plus]');
        this.form = this.querySelector('[data-product-form]');
        this.addToCartButton = this.querySelector('[data-add-to-cart]');
        this.stickyBar = this.querySelector('[data-sticky-bar]');
        this.stickyAddToCart = this.querySelector('[data-sticky-add-to-cart]');
        this.variantIdInput = this.querySelector('[data-variant-id]');
        this.optionSelects = this.querySelectorAll('[data-option-select]');
        this.priceElement = this.querySelector('[data-price]');
        this.comparePriceElement = this.querySelector('[data-compare-price]');
        this.stickyPriceElement = this.querySelector('[data-sticky-price]');
        this.errorMessage = this.querySelector('[data-error-message]');
      }

      connectedCallback() {
        this.setupImageGallery();
        this.setupAccordion();
        this.setupQuantitySelector();
        this.setupVariantSelection();
        this.setupAddToCart();
        this.setupStickyBar();
      }

      setupImageGallery() {
        if (!this.mainImage || !this.thumbnails.length) return;

        this.thumbnails.forEach((thumbnail) => {
          thumbnail.addEventListener('click', () => {
            const imageUrl = thumbnail.dataset.imageUrl;
            this.mainImage.src = imageUrl;
            
            this.thumbnails.forEach((t) => t.classList.remove('active'));
            thumbnail.classList.add('active');
          });
        });
      }

      setupAccordion() {
        this.accordionItems.forEach((item) => {
          const trigger = item.querySelector('[data-accordion-trigger]');
          
          trigger.addEventListener('click', () => {
            item.classList.toggle('active');
          });
        });
      }

      setupQuantitySelector() {
        if (!this.quantityInput) return;

        this.quantityMinus.addEventListener('click', () => {
          const currentValue = parseInt(this.quantityInput.value);
          if (currentValue > 1) {
            this.quantityInput.value = currentValue - 1;
          }
        });

        this.quantityPlus.addEventListener('click', () => {
          const currentValue = parseInt(this.quantityInput.value);
          this.quantityInput.value = currentValue + 1;
        });

        this.quantityInput.addEventListener('change', () => {
          const value = parseInt(this.quantityInput.value);
          if (value < 1 || isNaN(value)) {
            this.quantityInput.value = 1;
          }
        });
      }

      setupVariantSelection() {
        if (!this.optionSelects.length) return;

        this.optionSelects.forEach((select) => {
          select.addEventListener('change', () => {
            this.updateVariant();
          });
        });
      }

      updateVariant() {
        const selectedOptions = Array.from(this.optionSelects).map((select) => select.value);
        
        const productData = JSON.parse(document.querySelector('[data-product-json]')?.textContent || '{}');
        if (!productData.variants) return;

        const matchedVariant = productData.variants.find((variant) => {
          return variant.options.every((option, index) => option === selectedOptions[index]);
        });

        if (matchedVariant) {
          this.variantIdInput.value = matchedVariant.id;
          
          if (this.priceElement) {
            this.priceElement.textContent = this.formatMoney(matchedVariant.price);
          }
          
          if (this.stickyPriceElement) {
            this.stickyPriceElement.textContent = this.formatMoney(matchedVariant.price);
          }

          if (this.comparePriceElement && matchedVariant.compare_at_price > matchedVariant.price) {
            this.comparePriceElement.textContent = this.formatMoney(matchedVariant.compare_at_price);
            this.comparePriceElement.style.display = 'inline';
          } else if (this.comparePriceElement) {
            this.comparePriceElement.style.display = 'none';
          }

          if (matchedVariant.available) {
            this.addToCartButton.disabled = false;
            this.addToCartButton.textContent = '{{ block.settings.add_to_cart_text }}';
            if (this.stickyAddToCart) {
              this.stickyAddToCart.disabled = false;
              this.stickyAddToCart.textContent = '{{ block.settings.add_to_cart_text }}';
            }
          } else {
            this.addToCartButton.disabled = true;
            this.addToCartButton.textContent = 'Sold Out';
            if (this.stickyAddToCart) {
              this.stickyAddToCart.disabled = true;
              this.stickyAddToCart.textContent = 'Sold Out';
            }
          }
        }
      }

      formatMoney(cents) {
        const dollars = cents / 100;
        return '$' + dollars.toFixed(2);
      }

      setupAddToCart() {
        if (!this.form) return;

        this.form.addEventListener('submit', async (e) => {
          e.preventDefault();
          
          this.addToCartButton.disabled = true;
          const originalText = this.addToCartButton.textContent;
          this.addToCartButton.textContent = 'Adding...';
          
          if (this.errorMessage) {
            this.errorMessage.classList.remove('visible');
          }

          const formData = new FormData(this.form);

          try {
            const response = await fetch('/cart/add.js', {
              method: 'POST',
              body: formData
            });

            if (!response.ok) {
              throw new Error('Failed to add to cart');
            }

            const data = await response.json();
            
            this.addToCartButton.textContent = 'Added!';
            
            const cartDrawer = document.querySelector('cart-drawer');
            if (cartDrawer) {
              cartDrawer.open();
            }

            setTimeout(() => {
              this.addToCartButton.textContent = originalText;
              this.addToCartButton.disabled = false;
            }, 2000);

          } catch (error) {
            console.error('Error adding to cart:', error);
            
            if (this.errorMessage) {
              this.errorMessage.textContent = 'Unable to add item to cart. Please try again.';
              this.errorMessage.classList.add('visible');
            }
            
            this.addToCartButton.textContent = originalText;
            this.addToCartButton.disabled = false;
          }
        });

        if (this.stickyAddToCart) {
          this.stickyAddToCart.addEventListener('click', () => {
            this.addToCartButton.click();
          });
        }
      }

      setupStickyBar() {
        if (!this.stickyBar) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) {
                this.stickyBar.style.display = 'block';
              } else {
                this.stickyBar.style.display = 'none';
              }
            });
          },
          { threshold: 0 }
        );

        if (this.addToCartButton) {
          observer.observe(this.addToCartButton);
        }
      }
    }

    customElements.define('product-page-{{ ai_gen_id }}', ProductPage{{ ai_gen_id }});
  })();
</script>

<script type="application/json" data-product-json>
  {{ product | json }}
</script>

