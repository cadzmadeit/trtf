{% doc %}
  @prompt
    Create a customer testimonials section with the heading "What Our Customers Say" that displays customer reviews in a horizontal layout. Each review should show a circular avatar with the customer's initial, customer name, location, date, 5-star rating display, and review text. Include navigation arrows at the bottom for sliding between reviews. Style it with a clean, modern design with proper spacing and typography that matches a professional e-commerce site., make the button actually scroll to the next review, and make sure the auto slide actually slides every 3 seconds, make the arrow buttons actually scroll between testimonials and make the autoplay actually switch between testimonials every 3 seconds. MAKE THE BUTTONS WORK

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonials-section-{{ ai_gen_id }} {
    padding: 60px 20px;
    background-color: {{ block.settings.background_color }};
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-testimonials-heading-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 50px;
    font-weight: 600;
  }

  .ai-testimonials-container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    margin-bottom: 40px;
  }

  .ai-testimonials-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
    gap: 30px;
  }

  .ai-testimonial-card-{{ ai_gen_id }} {
    flex: 0 0 calc({{ block.settings.cards_per_view }}% - 30px);
    min-width: calc({{ block.settings.cards_per_view }}% - 30px);
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 30px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    border: 1px solid {{ block.settings.card_border_color }};
  }

  .ai-testimonial-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 20px;
  }

  .ai-testimonial-avatar-{{ ai_gen_id }} {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: {{ block.settings.avatar_background }};
    color: {{ block.settings.avatar_text_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    font-weight: 600;
    flex-shrink: 0;
  }

  .ai-testimonial-info-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-testimonial-name-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 5px;
  }

  .ai-testimonial-location-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.secondary_text_color }};
    margin: 0 0 5px;
  }

  .ai-testimonial-date-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.secondary_text_color }};
    margin: 0;
  }

  .ai-testimonial-rating-{{ ai_gen_id }} {
    display: flex;
    gap: 3px;
    margin-bottom: 20px;
  }

  .ai-testimonial-star-{{ ai_gen_id }} {
    width: 18px;
    height: 18px;
    color: {{ block.settings.star_color }};
  }

  .ai-testimonial-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-testimonials-navigation-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 15px;
    align-items: center;
  }

  .ai-testimonials-nav-button-{{ ai_gen_id }} {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background-color: {{ block.settings.nav_button_background }};
    border: 1px solid {{ block.settings.nav_button_border }};
    color: {{ block.settings.nav_button_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-testimonials-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_background }};
    color: {{ block.settings.nav_button_hover_color }};
  }

  .ai-testimonials-nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-testimonials-dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-testimonials-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_inactive_color }};
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-testimonials-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
  }

  @media screen and (max-width: 768px) {
    .ai-testimonials-section-{{ ai_gen_id }} {
      padding: 40px 15px;
    }

    .ai-testimonial-card-{{ ai_gen_id }} {
      flex: 0 0 100%;
      min-width: 100%;
      padding: 25px;
    }

    .ai-testimonials-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
      margin-bottom: 30px;
    }

    .ai-testimonial-avatar-{{ ai_gen_id }} {
      width: 50px;
      height: 50px;
      font-size: 20px;
    }

    .ai-testimonial-name-{{ ai_gen_id }} {
      font-size: 16px;
    }
  }
{% endstyle %}

<testimonials-slider-{{ ai_gen_id }}
  class="ai-testimonials-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  data-autoplay="{{ block.settings.enable_autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
>
  <h2 class="ai-testimonials-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>

  <div class="ai-testimonials-container-{{ ai_gen_id }}">
    <div class="ai-testimonials-track-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign name_key = 'testimonial_' | append: i | append: '_name'
          assign location_key = 'testimonial_' | append: i | append: '_location'
          assign date_key = 'testimonial_' | append: i | append: '_date'
          assign text_key = 'testimonial_' | append: i | append: '_text'
          assign rating_key = 'testimonial_' | append: i | append: '_rating'

          assign name = block.settings[name_key]
          assign location = block.settings[location_key]
          assign date = block.settings[date_key]
          assign text = block.settings[text_key]
          assign rating = block.settings[rating_key]
        %}

        {% if name != blank and text != blank %}
          <div class="ai-testimonial-card-{{ ai_gen_id }}">
            <div class="ai-testimonial-header-{{ ai_gen_id }}">
              <div class="ai-testimonial-avatar-{{ ai_gen_id }}">
                {{ name | slice: 0 | upcase }}
              </div>
              <div class="ai-testimonial-info-{{ ai_gen_id }}">
                <h3 class="ai-testimonial-name-{{ ai_gen_id }}">{{ name }}</h3>
                {% if location != blank %}
                  <p class="ai-testimonial-location-{{ ai_gen_id }}">{{ location }}</p>
                {% endif %}
                {% if date != blank %}
                  <p class="ai-testimonial-date-{{ ai_gen_id }}">{{ date }}</p>
                {% endif %}
              </div>
            </div>

            <div class="ai-testimonial-rating-{{ ai_gen_id }}">
              {% for star in (1..5) %}
                <svg
                  class="ai-testimonial-star-{{ ai_gen_id }}"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="{% if star <= rating %}currentColor{% else %}none{% endif %}"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"></polygon>
                </svg>
              {% endfor %}
            </div>

            <p class="ai-testimonial-text-{{ ai_gen_id }}">{{ text }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="ai-testimonials-navigation-{{ ai_gen_id }}">
    <button
      class="ai-testimonials-nav-button-{{ ai_gen_id }} ai-testimonials-prev-{{ ai_gen_id }}"
      aria-label="Previous testimonials"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="15,18 9,12 15,6"></polyline>
      </svg>
    </button>

    <div class="ai-testimonials-dots-{{ ai_gen_id }}"></div>

    <button
      class="ai-testimonials-nav-button-{{ ai_gen_id }} ai-testimonials-next-{{ ai_gen_id }}"
      aria-label="Next testimonials"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="9,18 15,12 9,6"></polyline>
      </svg>
    </button>
  </div>
</testimonials-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class TestimonialsSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.autoplayEnabled = this.getAttribute('data-autoplay') === 'true';
        this.autoplaySpeed = parseInt(this.getAttribute('data-autoplay-speed')) * 1000 || 3000;
        this.autoplayInterval = null;
        this.isTransitioning = false;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-testimonials-track-{{ ai_gen_id }}');
        this.cards = Array.from(this.querySelectorAll('.ai-testimonial-card-{{ ai_gen_id }}'));
        this.prevButton = this.querySelector('.ai-testimonials-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-testimonials-next-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-testimonials-dots-{{ ai_gen_id }}');
        
        if (this.cards.length === 0) return;
        
        this.updateCardsPerView();
        this.createDots();
        this.updateSlider();
        this.setupEventListeners();
        
        if (this.autoplayEnabled && this.cards.length > this.cardsPerView) {
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
        window.removeEventListener('resize', this.resizeHandler);
      }

      updateCardsPerView() {
        if (window.innerWidth <= 768) {
          this.cardsPerView = 1;
        } else {
          // Convert percentage string to number (e.g., "33.333%" -> 33.333)
          const cardsPerViewSetting = parseFloat({{ block.settings.cards_per_view | json }});
          this.cardsPerView = 100 / cardsPerViewSetting;
        }
        
        this.totalSlides = Math.max(1, this.cards.length - this.cardsPerView + 1);
        this.currentIndex = Math.min(this.currentIndex, this.totalSlides - 1);
      }

      createDots() {
        this.dotsContainer.innerHTML = '';
        for (let i = 0; i < this.totalSlides; i++) {
          const dot = document.createElement('div');
          dot.className = 'ai-testimonials-dot-{{ ai_gen_id }}';
          dot.setAttribute('data-index', i);
          dot.addEventListener('click', () => {
            this.goToSlide(i);
            this.restartAutoplay();
          });
          this.dotsContainer.appendChild(dot);
        }
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => {
          this.previousSlide();
          this.restartAutoplay();
        });
        
        this.nextButton.addEventListener('click', () => {
          this.nextSlide();
          this.restartAutoplay();
        });

        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => {
          if (this.autoplayEnabled) {
            this.startAutoplay();
          }
        });

        this.resizeHandler = () => {
          const oldCardsPerView = this.cardsPerView;
          this.updateCardsPerView();
          
          if (oldCardsPerView !== this.cardsPerView) {
            this.createDots();
            this.updateSlider();
          }
        };
        
        window.addEventListener('resize', this.resizeHandler);
      }

      startAutoplay() {
        if (this.autoplayInterval) return;
        
        this.autoplayInterval = setInterval(() => {
          if (this.currentIndex < this.totalSlides - 1) {
            this.nextSlide();
          } else {
            this.goToSlide(0);
          }
        }, this.autoplaySpeed);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      restartAutoplay() {
        if (this.autoplayEnabled) {
          this.stopAutoplay();
          this.startAutoplay();
        }
      }

      previousSlide() {
        if (this.isTransitioning) return;
        
        if (this.currentIndex > 0) {
          this.goToSlide(this.currentIndex - 1);
        }
      }

      nextSlide() {
        if (this.isTransitioning) return;
        
        if (this.currentIndex < this.totalSlides - 1) {
          this.goToSlide(this.currentIndex + 1);
        }
      }

      goToSlide(index) {
        if (this.isTransitioning || index === this.currentIndex) return;
        
        this.isTransitioning = true;
        this.currentIndex = index;
        this.updateSlider();
        
        // Reset the transition flag after animation completes
        setTimeout(() => {
          this.isTransitioning = false;
        }, 500); // Match this with your CSS transition time
      }

      updateSlider() {
        if (!this.cards.length) return;
        
        const cardWidth = this.cards[0].offsetWidth;
        const gap = 30; // Match this with your CSS gap value
        const translateX = -(this.currentIndex * (cardWidth + gap));
        
        this.track.style.transform = `translateX(${translateX}px)`;
        
        // Update button states
        this.prevButton.disabled = this.currentIndex === 0;
        this.nextButton.disabled = this.currentIndex >= this.totalSlides - 1;
        
        // Update dots
        const dots = this.querySelectorAll('.ai-testimonials-dot-{{ ai_gen_id }}');
        dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === this.currentIndex);
        });
      }
    }

    customElements.define('testimonials-slider-{{ ai_gen_id }}', TestimonialsSlider{{ ai_gen_id }});
  })();
</script>

