{% doc %}
  @prompt
    Countdown minimal

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-countdown-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-countdown-container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    align-items: center;
  }

  .ai-countdown-unit-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ai-countdown-number-{{ ai_gen_id }} {
    font-size: {{ block.settings.number_size }}px;
    font-weight: 700;
    color: {{ block.settings.number_color }};
    line-height: 1;
    margin-bottom: 4px;
    min-width: 2ch;
  }

  .ai-countdown-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 500;
  }

  .ai-countdown-separator-{{ ai_gen_id }} {
    font-size: {{ block.settings.number_size }}px;
    color: {{ block.settings.number_color }};
    font-weight: 700;
    margin: 0 4px;
  }

  .ai-countdown-expired-{{ ai_gen_id }} {
    font-size: {{ block.settings.number_size }}px;
    color: {{ block.settings.expired_color }};
    font-weight: 700;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-countdown-number-{{ ai_gen_id }} {
      font-size: {{ block.settings.number_size | times: 0.8 }}px;
    }

    .ai-countdown-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_size | times: 0.9 }}px;
    }

    .ai-countdown-separator-{{ ai_gen_id }} {
      font-size: {{ block.settings.number_size | times: 0.8 }}px;
    }

    .ai-countdown-container-{{ ai_gen_id }} {
      gap: {{ block.settings.gap | times: 0.7 }}px;
    }
  }
{% endstyle %}

<countdown-timer-{{ ai_gen_id }}
  class="ai-countdown-{{ ai_gen_id }}"
  data-target-date="{{ block.settings.target_date }}"
  data-target-time="{{ block.settings.target_time }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-countdown-container-{{ ai_gen_id }}">
    {% if block.settings.show_days %}
      <div class="ai-countdown-unit-{{ ai_gen_id }}">
        <div class="ai-countdown-number-{{ ai_gen_id }}" data-days>00</div>
        <div class="ai-countdown-label-{{ ai_gen_id }}">Days</div>
      </div>
      {% if block.settings.show_hours or block.settings.show_minutes or block.settings.show_seconds %}
        <div class="ai-countdown-separator-{{ ai_gen_id }}">:</div>
      {% endif %}
    {% endif %}

    {% if block.settings.show_hours %}
      <div class="ai-countdown-unit-{{ ai_gen_id }}">
        <div class="ai-countdown-number-{{ ai_gen_id }}" data-hours>00</div>
        <div class="ai-countdown-label-{{ ai_gen_id }}">Hours</div>
      </div>
      {% if block.settings.show_minutes or block.settings.show_seconds %}
        <div class="ai-countdown-separator-{{ ai_gen_id }}">:</div>
      {% endif %}
    {% endif %}

    {% if block.settings.show_minutes %}
      <div class="ai-countdown-unit-{{ ai_gen_id }}">
        <div class="ai-countdown-number-{{ ai_gen_id }}" data-minutes>00</div>
        <div class="ai-countdown-label-{{ ai_gen_id }}">Minutes</div>
      </div>
      {% if block.settings.show_seconds %}
        <div class="ai-countdown-separator-{{ ai_gen_id }}">:</div>
      {% endif %}
    {% endif %}

    {% if block.settings.show_seconds %}
      <div class="ai-countdown-unit-{{ ai_gen_id }}">
        <div class="ai-countdown-number-{{ ai_gen_id }}" data-seconds>00</div>
        <div class="ai-countdown-label-{{ ai_gen_id }}">Seconds</div>
      </div>
    {% endif %}
  </div><div class="ai-countdown-expired-{{ ai_gen_id }}" data-expired style="display: none;">
    {{ block.settings.expired_message }}
  </div>
</countdown-timer-{{ ai_gen_id }}><script>
  (function() {
    class CountdownTimer{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.targetDate = null;
        this.interval = null;
      }

      connectedCallback() {
        this.setupTargetDate();
        this.startCountdown();
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }

      setupTargetDate() {
        const dateStr = this.dataset.targetDate;
        const timeStr = this.dataset.targetTime;
        
        if (!dateStr) return;

        const dateTimeStr = timeStr ? `${dateStr}T${timeStr}` : dateStr;
        this.targetDate = new Date(dateTimeStr);
      }

      startCountdown() {
        if (!this.targetDate) return;

        this.updateDisplay();
        this.interval = setInterval(() => {
          this.updateDisplay();
        }, 1000);
      }

      updateDisplay() {
        const now = new Date().getTime();
        const distance = this.targetDate.getTime() - now;

        if (distance < 0) {
          this.showExpired();
          return;
        }

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        const daysElement = this.querySelector('[data-days]');
        const hoursElement = this.querySelector('[data-hours]');
        const minutesElement = this.querySelector('[data-minutes]');
        const secondsElement = this.querySelector('[data-seconds]');

        if (daysElement) daysElement.textContent = String(days).padStart(2, '0');
        if (hoursElement) hoursElement.textContent = String(hours).padStart(2, '0');
        if (minutesElement) minutesElement.textContent = String(minutes).padStart(2, '0');
        if (secondsElement) secondsElement.textContent = String(seconds).padStart(2, '0');
      }

      showExpired() {
        if (this.interval) {
          clearInterval(this.interval);
        }

        const container = this.querySelector('.ai-countdown-container-{{ ai_gen_id }}');
        const expiredElement = this.querySelector('[data-expired]');

        if (container) container.style.display = 'none';
        if (expiredElement) expiredElement.style.display = 'block';
      }
    }

    customElements.define('countdown-timer-{{ ai_gen_id }}', CountdownTimer{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Countdown timer",
  "settings": [
    {
      "type": "header",
      "content": "Target date"
    },
    {
      "type": "text",
      "id": "target_date",
      "label": "Target date",
      "info": "Format: YYYY-MM-DD (e.g., 2024-12-25)"
    },
    {
      "type": "text",
      "id": "target_time",
      "label": "Target time",
      "info": "Format: HH:MM (e.g., 23:59). Leave empty for midnight."
    },
    {
      "type": "text",
      "id": "expired_message",
      "label": "Expired message",
      "default": "Time's up!"
    },
    {
      "type": "header",
      "content": "Display options"
    },
    {
      "type": "checkbox",
      "id": "show_days",
      "label": "Show days",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_hours",
      "label": "Show hours",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_minutes",
      "label": "Show minutes",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_seconds",
      "label": "Show seconds",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Number color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "expired_color",
      "label": "Expired message color",
      "default": "#ff0000"
    },
    {
      "type": "range",
      "id": "number_size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Number size",
      "default": 48
    },
    {
      "type": "range",
      "id": "label_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Label size",
      "default": 12
    },
    {
      "type": "range",
      "id": "gap",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Gap between units",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Countdown timer"
    }
  ],
  "tag": null
}
{% endschema %}