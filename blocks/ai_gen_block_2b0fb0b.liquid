{% doc %}
  @prompt
    Create a fully customizable announcement banner with fade transitions between multiple announcements using arrow navigation. The banner should use the theme's font family in all caps with responsive font sizing that automatically scales down to keep text on one line. Include a close (X) button positioned so arrows don't cover it. The banner should be mobile-responsive, displaying promotional messages horizontally on mobile with dark background, white text and icons for "Free Shipping", "Free Mystery item", and "Secure Payments". Include comprehensive customization options for background color, text color, font size (that actually works when edited), icon selection, message text, transition speed, and show/hide options for each element. Ensure the font matches the AI-generated slideshow section and automatically adjusts size to fit content in one line., now just make the icons better, make the font size adjustable. the words should say, free shipping, free mystery item, and secure payments, make the font size be able to go even smaller, make the text the same size as the custom banner section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    font-weight: {{ settings.type_header_font.weight }};
    font-style: {{ settings.type_header_font.style }};
    text-transform: uppercase;
    overflow: hidden;
    z-index: 1000;
  }

  .ai-announcement-banner-container-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: {{ block.settings.banner_height }}px;
    padding: 12px 60px;
  }

  .ai-announcement-content-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: 100%;
    text-align: center;
  }

  .ai-announcement-slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity {{ block.settings.transition_speed }}ms ease-in-out, visibility {{ block.settings.transition_speed }}ms ease-in-out;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    white-space: nowrap;
  }

  .ai-announcement-slide-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
    position: relative;
  }

  .ai-announcement-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.2;
    letter-spacing: {{ settings.type_header_letter_spacing }}px;
    margin: 0;
    flex-shrink: 1;
    min-width: 0;
  }

  .ai-announcement-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    fill: currentColor;
  }

  .ai-announcement-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: {{ block.settings.text_color }};
    cursor: pointer;
    padding: 8px;
    opacity: 0.7;
    transition: opacity 0.3s ease;
    z-index: 2;
  }

  .ai-announcement-nav-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-announcement-nav-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .ai-announcement-nav-prev-{{ ai_gen_id }} {
    left: 16px;
  }

  .ai-announcement-nav-next-{{ ai_gen_id }} {
    right: 16px;
  }

  .ai-announcement-close-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    right: 16px;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: {{ block.settings.text_color }};
    cursor: pointer;
    padding: 8px;
    opacity: 0.7;
    transition: opacity 0.3s ease;
    z-index: 3;
  }

  .ai-announcement-close-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-announcement-close-{{ ai_gen_id }} svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  @media screen and (max-width: 768px) {
    .ai-announcement-banner-container-{{ ai_gen_id }} {
      padding: 12px 50px;
    }

    .ai-announcement-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.font_size }}px * 0.85);
    }

    .ai-announcement-icon-{{ ai_gen_id }} {
      width: calc({{ block.settings.icon_size }}px * 0.85);
      height: calc({{ block.settings.icon_size }}px * 0.85);
    }

    .ai-announcement-nav-{{ ai_gen_id }} svg {
      width: 16px;
      height: 16px;
    }

    .ai-announcement-close-{{ ai_gen_id }} svg {
      width: 16px;
      height: 16px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-announcement-banner-container-{{ ai_gen_id }} {
      padding: 10px 40px;
    }

    .ai-announcement-slide-{{ ai_gen_id }} {
      gap: 12px;
    }

    .ai-announcement-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.font_size }}px * 0.75);
      white-space: normal;
      line-height: 1.3;
    }

    .ai-announcement-icon-{{ ai_gen_id }} {
      width: calc({{ block.settings.icon_size }}px * 0.75);
      height: calc({{ block.settings.icon_size }}px * 0.75);
    }
  }
{% endstyle %}

