</announcement-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class AnnouncementBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.slides = [];
        this.autoRotateInterval = null;
        this.isVisible = true;
      }

      connectedCallback() {
        this.slides = Array.from(this.querySelectorAll('.ai-announcement-slide-{{ ai_gen_id }}'));
        this.totalSlides = this.slides.length;
        
        if (this.totalSlides <= 1) return;

        this.setupEventListeners();
        this.setupAutoRotation();
        this.adjustFontSize();
        
        window.addEventListener('resize', () => this.adjustFontSize());
      }

      disconnectedCallback() {
        if (this.autoRotateInterval) {
          clearInterval(this.autoRotateInterval);
        }
        window.removeEventListener('resize', () => this.adjustFontSize());
      }

      setupEventListeners() {
        const prevButton = this.querySelector('.ai-announcement-nav-prev-{{ ai_gen_id }}');
        const nextButton = this.querySelector('.ai-announcement-nav-next-{{ ai_gen_id }}');
        const closeButton = this.querySelector('.ai-announcement-close-{{ ai_gen_id }}');

        if (prevButton) {
          prevButton.addEventListener('click', () => this.previousSlide());
        }

        if (nextButton) {
          nextButton.addEventListener('click', () => this.nextSlide());
        }

        if (closeButton) {
          closeButton.addEventListener('click', () => this.closeBanner());
        }

        this.addEventListener('mouseenter', () => this.pauseAutoRotation());
        this.addEventListener('mouseleave', () => this.resumeAutoRotation());
      }

      setupAutoRotation() {
        const autoRotate = this.dataset.autoRotate === 'true';
        const rotationSpeed = parseInt(this.dataset.rotationSpeed) || 5000;

        if (autoRotate && this.totalSlides > 1) {
          this.autoRotateInterval = setInterval(() => {
            this.nextSlide();
          }, rotationSpeed);
        }
      }

      pauseAutoRotation() {
        if (this.autoRotateInterval) {
          clearInterval(this.autoRotateInterval);
        }
      }

      resumeAutoRotation() {
        this.setupAutoRotation();
      }

      nextSlide() {
        this.currentSlide = (this.currentSlide + 1) % this.totalSlides;
        this.showSlide(this.currentSlide);
      }

      previousSlide() {
        this.currentSlide = (this.currentSlide - 1 + this.totalSlides) % this.totalSlides;
        this.showSlide(this.currentSlide);
      }

      showSlide(index) {
        this.slides.forEach((slide, i) => {
          slide.classList.toggle('active', i === index);
        });
      }

      closeBanner() {
        this.style.display = 'none';
        this.isVisible = false;
        
        try {
          localStorage.setItem('announcement-banner-{{ ai_gen_id }}-closed', 'true');
        } catch (e) {
          console.warn('Could not save banner state to localStorage');
        }
      }

      adjustFontSize() {
        const textElements = this.querySelectorAll('.ai-announcement-text-{{ ai_gen_id }}');
        const container = this.querySelector('.ai-announcement-banner-container-{{ ai_gen_id }}');
        
        if (!container) return;

        textElements.forEach(textElement => {
          const slide = textElement.closest('.ai-announcement-slide-{{ ai_gen_id }}');
          if (!slide) return;

          slide.classList.add('active');
          
          let fontSize = {{ block.settings.font_size }};
          const minFontSize = Math.max(6, fontSize * 0.6);
          const maxWidth = container.offsetWidth - 120;
          
          textElement.style.fontSize = fontSize + 'px';
          
          while (textElement.scrollWidth > maxWidth && fontSize > minFontSize) {
            fontSize -= 1;
            textElement.style.fontSize = fontSize + 'px';
          }
          
          if (slide.dataset.slide !== '1') {
            slide.classList.remove('active');
          }
        });
      }
    }

    customElements.define('announcement-banner-{{ ai_gen_id }}', AnnouncementBanner{{ ai_gen_id }});

    document.addEventListener('DOMContentLoaded', function() {
      const banner = document.querySelector('announcement-banner-{{ ai_gen_id }}');
      if (banner) {
        try {
          const isClosed = localStorage.getItem('announcement-banner-{{ ai_gen_id }}-closed');
          if (isClosed === 'true') {
            banner.style.display = 'none';
          }
        } catch (e) {
          console.warn('Could not read banner state from localStorage');
        }
      }
    });
  })();
</script>

