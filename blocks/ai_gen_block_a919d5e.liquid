{% doc %}
  @prompt
    Optimize the slideshow section for desktop view by making images display side by side or reducing their size on desktop only. Ensure the layout is responsive and only affects desktop screens while maintaining mobile functionality., now make it so that the desktop column view is FIXED to desktop and mobile is still optimized as the REGULAR mobile slideshow view from the theme, now only make it 2 images maximum, the buttons to control the slideshow don't actually work, make them slide between slides. Desktop view should have 2 columns while mobile view is a traditional slideshow. Lastly, add customizable button, heading, and subheading that FOLLOWS THE RULES OF THE THEMES SLIDESHOW SECTION, make the heading and subheading not for the section. but for the actual images, as well as the buttons, the heading and subheading as well as buttons should be THE SAME as the theme meaning bottom left of the image and the subheading top left. the DESKTOP VIEW ONLY should have 2 columns while keeping the mobile view the same. The desktop view should have two side by side image columns, make the images a bit taller the width is good. make sure the desktop view has 2 separate columns fitting both images and is optimized for desktop, while keeping mobile view optimized for mobile, make the heading, subheading, and buttons exactly like the themes slideshow layout., make the buttons and the heading text stuck to the bottom left. make the heading text the same size and font as the themes slideshow section. make it customizable just like the themes slideshow section.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-slideshow-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    margin: 0 auto;
  }

  .ai-slideshow-container-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;width: 100%;}

  .ai-slide-{{ ai_gen_id }} {
    flex: 0 0 100%;
    width: 100%;
    position: relative;
  }

  .ai-slide-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.aspect_ratio }}%;
    overflow: hidden;
  }

  .ai-slide-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
  }

  .ai-slide-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;}

  .ai-slide-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.5;
  }

  .ai-slide-content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: {{ block.settings.content_padding }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-slide-subheading-{{ ai_gen_id }} {
    font-family: {{ block.settings.subheading_font.family }}, {{ block.settings.subheading_font.fallback_families }};
    font-weight: {{ block.settings.subheading_font.weight }};
    font-style: {{ block.settings.subheading_font.style }};
    font-size: calc({{ block.settings.subheading_size }}px * {{ block.settings.subheading_scale | divided_by: 100.0 }});
    color: {{ block.settings.subheading_color }};
    text-shadow: {{ block.settings.text_shadow_horizontal }}px {{ block.settings.text_shadow_vertical }}px {{ block.settings.text_shadow_blur }}px rgba(0,0,0,{{ block.settings.text_shadow_opacity | divided_by: 100.0 }});
    margin:0;
    padding: 0;
    text-transform: {{ block.settings.subheading_text_transform }};
    letter-spacing: {{ block.settings.subheading_letter_spacing }}px;
    line-height: {{ block.settings.subheading_line_height }};
  }

  .ai-slide-bottom-content-{{ ai_gen_id }} {
    align-self: flex-start;
    max-width: {{ block.settings.content_max_width }}%;
  }

  .ai-slide-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    font-size: calc({{ block.settings.heading_size }}px * {{ block.settings.heading_scale | divided_by: 100.0 }});
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px 0;
    color: {{ block.settings.heading_color }};
    text-shadow: {{ block.settings.text_shadow_horizontal }}px {{ block.settings.text_shadow_vertical }}px {{ block.settings.text_shadow_blur }}px rgba(0,0,0,{{ block.settings.text_shadow_opacity | divided_by: 100.0 }});
    text-transform: {{ block.settings.heading_text_transform }};
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    line-height: {{ block.settings.heading_line_height }};
  }

  .ai-slide-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    font-style: {{ block.settings.button_font.style }};
    font-size: calc({{ block.settings.button_size }}px * {{ block.settings.button_scale | divided_by: 100.0 }});
    text-transform: {{ block.settings.button_text_transform }};
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    box-shadow: {{ block.settings.button_shadow_horizontal }}px {{ block.settings.button_shadow_vertical }}px {{ block.settings.button_shadow_blur }}px rgba(0,0,0,{{ block.settings.button_shadow_opacity | divided_by: 100.0 }});
  }

  .ai-slide-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY({{ block.settings.button_hover_transform }}px);
  }

  .ai-slideshow-controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    margin-top: 15px;
    gap: 10px;
  }

  .ai-slideshow-nav-button-{{ ai_gen_id }} {
    background-color: {{ block.settings.controls_color }};
    color: {{ block.settings.controls_text_color }};
    border: none;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.3s;
  }

  .ai-slideshow-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.controls_hover_color }};
  }

  .ai-slideshow-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    margin-top: 15px;
    gap: 8px;
  }

  .ai-slideshow-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.5;
    cursor: pointer;
    transition: opacity 0.3s;
  }

  .ai-slideshow-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  /* Mobile-specific styles */
  @media screen and (max-width: 749px) {
    .ai-desktop-grid-{{ ai_gen_id }} {
      display: none;
    }
    .ai-mobile-slideshow-{{ ai_gen_id }} {
      display: block;
    }
    
    .ai-slide-content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding_mobile }}px;
    }
    
    .ai-slide-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * {{ block.settings.heading_scale_mobile | divided_by: 100.0 }});
    }
    
    .ai-slide-subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * {{ block.settings.subheading_scale_mobile | divided_by: 100.0 }});
    }
    
    .ai-slide-button-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.button_size }}px * {{ block.settings.button_scale_mobile | divided_by: 100.0 }});padding: {{ block.settings.button_padding_vertical_mobile }}px {{ block.settings.button_padding_horizontal_mobile }}px;
    }}

  /* Desktop-specific styles */
  @media screen and (min-width: 750px) {
    .ai-desktop-grid-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: {{ block.settings.desktop_gap }}px;max-width: 100%;
    }
    
    .ai-desktop-grid-{{ ai_gen_id }} .ai-slide-{{ ai_gen_id }} {
      width: 100%;
    }
    
    .ai-desktop-grid-{{ ai_gen_id }} .ai-slide-image-wrapper-{{ ai_gen_id }} {
      padding-bottom: {{ block.settings.aspect_ratio_desktop }}%;
    }
    
    .ai-mobile-slideshow-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<div class="ai-slideshow-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <!-- Desktop Grid View -->
  <div class="ai-desktop-grid-{{ ai_gen_id }}">
    {% for i in (1..2) %}
      {% assign image_key = 'image_' | append: i %}
      {% assign image = block.settings[image_key] %}
      {% assign heading_key = 'heading_' | append: i %}
      {% assign heading = block.settings[heading_key] %}
      {% assign subheading_key = 'subheading_' | append: i %}
      {% assign subheading = block.settings[subheading_key] %}
      {% assign button_label_key = 'button_label_' | append: i %}
      {% assign button_label = block.settings[button_label_key] %}
      {% assign button_link_key = 'button_link_' | append: i %}
      {% assign button_link = block.settings[button_link_key] %}
      <div class="ai-slide-{{ ai_gen_id }}">
        <div class="ai-slide-image-wrapper-{{ ai_gen_id }}">
          {% if image != blank %}
            <img 
              src="{{ image | image_url: width: 1500}}"
              loading="lazy"
              alt="{{ image.alt | escape }}"
              class="ai-slide-image-{{ ai_gen_id }}"width="{{ image.width }}"
              height="{{ image.height }}"
            >
          {% else %}
            <div class="ai-slide-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
          <div class="ai-slide-content-{{ ai_gen_id }}">
            {% if subheading != blank %}
              <div class="ai-slide-subheading-{{ ai_gen_id }}">{{ subheading }}</div>
            {% endif %}
            
            <div class="ai-slide-bottom-content-{{ ai_gen_id }}">
              {% if heading != blank %}
                <h2 class="ai-slide-heading-{{ ai_gen_id }}">{{ heading }}</h2>
              {% endif %}
              
              {% if button_label != blank and button_link != blank %}
                <a href="{{ button_link }}" class="ai-slide-button-{{ ai_gen_id }}">
                  {{ button_label }}
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  <!-- Mobile Slideshow View -->
  <mobile-slideshow-{{ ai_gen_id }} class="ai-mobile-slideshow-{{ ai_gen_id }}">
    <div class="ai-slideshow-container-{{ ai_gen_id }}">
      {% for i in (1..2) %}
        {% assign image_key = 'image_' | append: i %}
        {% assign image = block.settings[image_key] %}
        {% assign heading_key = 'heading_' | append: i %}
        {% assign heading = block.settings[heading_key] %}
        {% assign subheading_key = 'subheading_' | append: i %}
        {% assign subheading = block.settings[subheading_key] %}
        {% assign button_label_key = 'button_label_' | append: i %}
        {% assign button_label = block.settings[button_label_key] %}
        {% assign button_link_key = 'button_link_' | append: i %}
        {% assign button_link = block.settings[button_link_key] %}
        
        <div class="ai-slide-{{ ai_gen_id }}" data-index="{{ forloop.index0 }}">
          <div class="ai-slide-image-wrapper-{{ ai_gen_id }}">
            {% if image != blank %}
              <img 
                src="{{ image | image_url: width: 1000 }}"
                loading="lazy"
                alt="{{ image.alt | escape }}"
                class="ai-slide-image-{{ ai_gen_id }}"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            {% else %}
              <div class="ai-slide-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
            
            <div class="ai-slide-content-{{ ai_gen_id }}">
              {% if subheading != blank %}
                <div class="ai-slide-subheading-{{ ai_gen_id }}">{{ subheading }}</div>
              {% endif %}
              
              <div class="ai-slide-bottom-content-{{ ai_gen_id }}">
                {% if heading != blank %}
                  <h2 class="ai-slide-heading-{{ ai_gen_id }}">{{ heading }}</h2>
                {% endif %}
                
                {% if button_label != blank and button_link != blank %}
                  <a href="{{ button_link }}" class="ai-slide-button-{{ ai_gen_id }}">
                    {{ button_label }}
                  </a>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="ai-slideshow-controls-{{ ai_gen_id }}">
      <button class="ai-slideshow-nav-button-{{ ai_gen_id }} ai-prev-{{ ai_gen_id }}" aria-label="Previous slide">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button class="ai-slideshow-nav-button-{{ ai_gen_id }} ai-next-{{ ai_gen_id }}" aria-label="Next slide">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    <div class="ai-slideshow-dots-{{ ai_gen_id }}"></div>
  </mobile-slideshow-{{ ai_gen_id }}>
</div>

<script>
  (function() {
    class MobileSlideshow extends HTMLElement {
      constructor() {
        super();
        this.container = this.querySelector('.ai-slideshow-container-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-next-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-slideshow-dots-{{ ai_gen_id }}');
        this.currentIndex = 0;
        this.dots = [];
        this.autoplayInterval = null;
        this.slideCount = this.slides.length;
      }

      connectedCallback() {
        if (this.slideCount <= 0) return;
        
        this.setupDots();
        this.setupEventListeners();
        this.updateSlidePosition();
        if ({{ block.settings.autoplay | json }}) {
          this.startAutoplay();
        }
      }

      setupDots() {
        this.dotsContainer.innerHTML = '';
        this.dots = [];
        
        for (let i = 0; i < this.slideCount; i++) {
          const dot = document.createElement('div');
          dot.classList.add('ai-slideshow-dot-{{ ai_gen_id }}');
          dot.setAttribute('data-index', i);
          this.dotsContainer.appendChild(dot);
          this.dots.push(dot);
          dot.addEventListener('click', () => {
            this.goToSlide(i);
            if ({{ block.settings.autoplay | json }}) {
              this.restartAutoplay();
            }
          });
        }
        
        this.updateActiveDot();
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => {
            this.goToPrevSlide();
            if ({{ block.settings.autoplay | json }}) {
              this.restartAutoplay();
            }
          });
        }
        
        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => {
            this.goToNextSlide();
            if ({{ block.settings.autoplay | json }}) {
              this.restartAutoplay();
            }
          });
        }}

      goToSlide(index) {
        this.currentIndex = index;
        this.updateSlidePosition();
      }

      goToPrevSlide() {
        this.currentIndex = (this.currentIndex - 1 + this.slideCount) % this.slideCount;
        this.updateSlidePosition();
      }

      goToNextSlide() {
        this.currentIndex = (this.currentIndex + 1) % this.slideCount;
        this.updateSlidePosition();
      }

      updateSlidePosition() {
        if (this.container) {
          this.container.style.transform = `translateX(-${this.currentIndex * 100}%)`;
          this.updateActiveDot();
        }
      }

      updateActiveDot() {
        if (this.dots.length > 0) {
          this.dots.forEach((dot, index) => {
            if (index === this.currentIndex) {
              dot.classList.add('active');
            } else {
              dot.classList.remove('active');
            }
          });
        }
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.goToNextSlide();
        }, {{ block.settings.autoplay_speed }} * 1000);
      }

      restartAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }
    }

    customElements.define('mobile-slideshow-{{ ai_gen_id }}', MobileSlideshow);
  })();
</script>

{% schema %}
{
  "name": "Dual View Slideshow",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Gap between images (desktop)",
      "default": 20
    },
    {
      "type": "range",
      "id": "aspect_ratio",
      "min": 50,
      "max": 200,
