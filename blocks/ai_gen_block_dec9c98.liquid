{% doc %}
  @prompt
    Create a fully customizable announcement banner with fade transitions between multiple announcements using arrow navigation. The banner should use the theme's font family in all caps with responsive font sizing that automatically scales down to keep text on one line. Include a close (X) button positioned so arrows don't cover it. The banner should be mobile-responsive, displaying promotional messages horizontally on mobile with dark background, white text and icons for "Free Shipping", "Free Mystery item", and "Secure Payments". Include comprehensive customization options for background color, text color, font size (that actually works when edited), icon selection, message text, transition speed, and show/hide options for each element. Ensure the font matches the AI-generated slideshow section and automatically adjusts size to fit content in one line., remove the fade animation. remove the close button. only make 3 announcements with no links. fix the icons., make it running with no navigation arrows, make it a running announcement as it, it keeps auto sliding to the right announcement to annoucment then repeats. seperate each announcemnet with a clean concise dot., remove the dot. make it so ITS never white. it always repeats , the announcement should start immediately and run continuously
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-weight: {{ settings.type_body_font.weight }};
    font-style: {{ settings.type_body_font.style }};
    text-transform: uppercase;
    letter-spacing: 0.5px;
    overflow: hidden;
    z-index: 100;
  }

  .ai-announcement-banner-content-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 12px 20px;
  }

  .ai-announcement-ticker-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    white-space: nowrap;
    animation: ai-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
  }

  .ai-announcement-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-right: 60px;
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.2;
  }

  .ai-announcement-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    fill: currentColor;
  }

  .ai-announcement-text-{{ ai_gen_id }} {
    flex-shrink: 0;
  }

  /* ✅ ONLY CHANGE — continuous loop fix */
  @keyframes ai-scroll-{{ ai_gen_id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-banner-content-{{ ai_gen_id }} {
      padding: 12px 16px;
    }

    .ai-announcement-item-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.font_size }}px * 0.85);
      gap: 8px;
      margin-right: 40px;
    }

    .ai-announcement-icon-{{ ai_gen_id }} {
      width: calc({{ block.settings.icon_size }}px * 0.8);
      height: calc({{ block.settings.icon_size }}px * 0.8);
    }
  }

  @media screen and (max-width: 480px) {
    .ai-announcement-item-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.font_size }}px * 0.75);
      gap: 6px;
      margin-right: 30px;
    }

    .ai-announcement-icon-{{ ai_gen_id }} {
      width: calc({{ block.settings.icon_size }}px * 0.7);
      height: calc({{ block.settings.icon_size }}px * 0.7);
    }
  }
{% endstyle %}

<div
  class="ai-announcement-banner-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-announcement-banner-content-{{ ai_gen_id }}">
    <div class="ai-announcement-ticker-{{ ai_gen_id }}">
      {% for repeat in (1..6) %}
        {% for i in (1..3) %}
          {% liquid
            assign enabled_key = 'announcement_' | append: i | append: '_enabled'
            assign text_key = 'announcement_' | append: i | append: '_text'
            assign icon_key = 'announcement_' | append: i | append: '_icon'

            assign is_enabled = block.settings[enabled_key]
            assign text = block.settings[text_key]
            assign icon = block.settings[icon_key]
          %}

          {% if is_enabled and text != blank %}
            <div class="ai-announcement-item-{{ ai_gen_id }}">
              {% if icon != 'none' %}
                <span class="ai-announcement-icon-{{ ai_gen_id }}">
                  {% case icon %}
                    {% when 'shipping' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="1" y="3" width="15" height="13"/>
                        <polygon points="16,6 20,6 23,11 23,16 16,16"/>
                        <circle cx="5.5" cy="18.5" r="2.5"/>
                        <circle cx="18.5" cy="18.5" r="2.5"/>
                      </svg>
                    {% when 'gift' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20,12 20,22 4,22 4,12"/>
                        <rect x="2" y="7" width="20" height="5"/>
                        <line x1="12" y1="22" x2="12" y2="7"/>
                        <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/>
                        <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
                      </svg>
                    {% when 'security' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        <path d="M9 12l2 2 4-4"/>
                      </svg>
                  {% endcase %}
                </span>
              {% endif %}
              
              <span class="ai-announcement-text-{{ ai_gen_id }}">{{ text }}</span>
            </div>
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Announcement banner",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Banner style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#cccccc"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 14
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 18
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Scroll speed",
      "default": 30
    },
    {
      "type": "header",
      "content": "Announcement 1"
    },
    {
      "type": "checkbox",
      "id": "announcement_1_enabled",
      "label": "Enable announcement 1",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_1_text",
      "label": "Text",
      "default": "Free shipping on orders over $50"
    },
    {
      "type": "select",
      "id": "announcement_1_icon",
      "label": "Icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "shipping", "label": "Shipping" },
        { "value": "gift", "label": "Gift" },
        { "value": "security", "label": "Security" }
      ],
      "default": "shipping"
    },
    {
      "type": "header",
      "content": "Announcement 2"
    },
    {
      "type": "checkbox",
      "id": "announcement_2_enabled",
      "label": "Enable announcement 2",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_2_text",
      "label": "Text",
      "default": "Free mystery item with every purchase"
    },
    {
      "type": "select",
      "id": "announcement_2_icon",
      "label": "Icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "shipping", "label": "Shipping" },
        { "value": "gift", "label": "Gift" },
        { "value": "security", "label": "Security" }
      ],
      "default": "gift"
    },
    {
      "type": "header",
      "content": "Announcement 3"
    },
    {
      "type": "checkbox",
      "id": "announcement_3_enabled",
      "label": "Enable announcement 3",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_3_text",
      "label": "Text",
      "default": "Secure payments guaranteed"
    },
    {
      "type": "select",
      "id": "announcement_3_icon",
      "label": "Icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "shipping", "label": "Shipping" },
        { "value": "gift", "label": "Gift" },
        { "value": "security", "label": "Security" }
      ],
      "default": "security"
    }
  ],
  "presets": [
    {
      "name": "Announcement banner"
    }
  ]
}
{% endschema %}
